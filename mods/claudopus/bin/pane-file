#!/bin/bash
# Puts files from this Mac into a page's file input in the Claude app's browser pane, where no tool opens the Mac's file
# window and a pasted file never reaches the page. A site's own security rules stop its pages fetching from this Mac, but they
# do not stop the pane opening a page here, and a page here may send the pane on to the site with a file's bytes in the address
# after the # (which the browser keeps to itself). So the file goes over in parts of about a megabyte, each stored in the site's
# own storage in the browser by a few lines of JavaScript run on the site, and on the upload page those parts become a file
# again, checked against the file's SHA-256, set on its file input as if picked by hand, and cleared from the site's storage.
#
#   pane-file FILE [FILE...]    serves the files on 127.0.0.1 until nothing has asked for a part for 10 minutes, and prints
#                               the steps and the JavaScript to run in the pane, filled in for these files (250 MB at most each)
#
# Start it detached with its output to a log, then read the log for the steps. It answers only on 127.0.0.1, only to an address
# that names a file by the random id it made for this run, only with Host 127.0.0.1, and never inside another page's frame; it
# sends a part only on to an https page. It sends nothing over the network itself.
set -u
[ $# -ge 1 ] || { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
for f in "$@"; do [ -f "$f" ] && [ -r "$f" ] || { echo "pane-file: no file $f" >&2; exit 1; }; done
py=$(command -v python3) || { echo "pane-file: needs python3" >&2; exit 1; }
exec "$py" -I -u - "$@" <<'PY'
import base64, hashlib, http.server, json, mimetypes, os, secrets, socketserver, sys, threading, time, urllib.parse

PART = 1_500_000          # characters of base64 in one address: Chromium takes addresses up to 2 MB
IDLE = 10 * 60            # stops when no part was asked for this long
MOST = 250 * 1024 * 1024  # each part is one step of the agent's: a bigger file takes hundreds

files = {}
for path in sys.argv[1:]:
    size = os.path.getsize(path)
    if size > MOST:
        sys.exit('pane-file: %s is %d MB, more than the 250 MB this carries' % (os.path.basename(path), size // 1048576))
    data = open(path, 'rb').read()
    b64 = base64.b64encode(data).decode()
    # The id is random for each run: it is the key to the file's parts, so no page can guess it or know it from the file
    files[secrets.token_hex(16)] = dict(name=os.path.basename(path), type=mimetypes.guess_type(path)[0] or 'application/octet-stream',
                                        size=len(data), sha=hashlib.sha256(data).hexdigest(),
                                        parts=[b64[i:i + PART] for i in range(0, len(b64), PART)] or [''], sent=set())
    del data, b64

last = [time.time()]
total = sum(len(f['parts']) for f in files.values())

def https_page(to):
    u = urllib.parse.urlsplit(to)
    return u.scheme == 'https' and bool(u.hostname) and not u.username and not u.password

class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def nothing(self):
        self.send_response(404); self.send_header('Content-Length', '0'); self.end_headers()
    def do_GET(self):
        # Another name for this address (a site's name pointed here) is not the pane asking
        if self.headers.get('Host') != '127.0.0.1:%d' % port: return self.nothing()
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        fid, to = q.get('id', [''])[0], q.get('to', [''])[0]
        try: i = int(q.get('i', ['0'])[0])
        except ValueError: i = -1
        f = files.get(fid)
        if u.path != '/go' or not f or not (0 <= i < len(f['parts'])) or not https_page(to): return self.nothing()
        last[0] = time.time()
        f['sent'].add(i)
        meta = urllib.parse.quote(json.dumps(dict(name=f['name'], type=f['type'], size=f['size'], sha=f['sha'])), safe='')
        dest = to.split('#')[0] + '#cpf:' + fid + ':' + str(i) + ':' + str(len(f['parts'])) + ':' + meta + ':' + f['parts'][i]
        # < written as \u003c, so nothing in the address can end the script and start markup of its own
        body = ('<!doctype html><meta charset=utf-8><title>Carrying a file</title><script>location.replace('
                + json.dumps(dest).replace('<', '\\u003c') + ')</script>').encode()
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Frame-Options', 'DENY')
        self.send_header('Content-Security-Policy', "frame-ancestors 'none'")
        self.send_header('Referrer-Policy', 'no-referrer')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        try: self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError): pass   # the pane moved on before the part was read: it asks again

class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True

srv = Server(('127.0.0.1', 0), Handler)
port = srv.server_address[1]
base = 'http://127.0.0.1:%d' % port

OPEN = "const db=await new Promise((ok,no)=>{const r=indexedDB.open('claudopus-files',1);r.onupgradeneeded=()=>r.result.createObjectStore('parts');r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)});"

CARRY = (r"""(async()=>{const m=/^#cpf:(\w+):(\d+):(\d+):([^:]*):(.*)$/s.exec(location.hash);if(!m)return 'no part in this address yet: '+location.href.slice(0,60);const[,id,i,n,meta,b]=m;""" + OPEN
         + r"""const s=atob(b),u=new Uint8Array(s.length);for(let k=0;k<s.length;k++)u[k]=s.charCodeAt(k);await new Promise((ok,no)=>{const t=db.transaction('parts','readwrite');t.objectStore('parts').put(u,id+':'+i);if(+i===0)t.objectStore('parts').put(JSON.parse(decodeURIComponent(meta)),id+':meta');t.oncomplete=ok;t.onerror=()=>no(t.error)});db.close();const next=+i+1;if(next<+n){location.replace('BASE/go?id='+id+'&i='+next+'&to='+encodeURIComponent(location.origin+location.pathname));return 'part '+next+' of '+n+' stored: run this again'}history.replaceState(null,'',location.pathname);return 'all '+n+' parts stored on '+location.origin})()""").replace('BASE', base)

# The file input a person would pick into: one in a dialog that shows, else the page's last; SEL names another
PUT = ("(async()=>{const ids=IDS,sel=null;" + OPEN
       + r"""const get=k=>new Promise((ok,no)=>{const q=db.transaction('parts').objectStore('parts').get(k);q.onsuccess=()=>ok(q.result);q.onerror=()=>no(q.error)});const dt=new DataTransfer(),out=[],gone=[];for(const id of ids){const meta=await get(id+':meta');if(!meta){db.close();return 'not carried to '+location.origin+' yet: '+id}const parts=[];for(let i=0;;i++){const p=await get(id+':'+i);if(!p)break;parts.push(p);gone.push(id+':'+i)}gone.push(id+':meta');const f=new File(parts,meta.name,{type:meta.type});const h=[...new Uint8Array(await crypto.subtle.digest('SHA-256',await f.arrayBuffer()))].map(x=>x.toString(16).padStart(2,'0')).join('');if(f.size!==meta.size||h!==meta.sha){db.close();return 'not the same file: '+meta.name+' came to '+f.size+' of '+meta.size+' bytes; carry it again'}dt.items.add(f);out.push(meta.name+' ('+f.size+' bytes, SHA-256 matches)')}const shown=e=>!!e&&(e.checkVisibility?e.checkVisibility({opacityProperty:true,visibilityProperty:true}):e.getClientRects().length>0),boxed=()=>[...document.querySelectorAll('[aria-modal=true] input[type=file],[role=dialog] input[type=file]')].find(e=>shown(e.closest('[aria-modal=true],[role=dialog]')));let inp=sel&&document.querySelector(sel);for(let w=0;!sel&&w<30&&!(inp=boxed())&&[...document.querySelectorAll('[aria-modal=true],[role=dialog]')].some(shown);w++)await new Promise(ok=>setTimeout(ok,500));if(!sel&&!inp)inp=[...document.querySelectorAll('input[type=file]')].pop();if(!inp){db.close();return 'no file input on this page yet; the parts stay for the next try'}inp.files=dt.files;inp.dispatchEvent(new Event('input',{bubbles:true}));inp.dispatchEvent(new Event('change',{bubbles:true}));await new Promise(ok=>{const t=db.transaction('parts','readwrite');for(const k of gone)t.objectStore('parts').delete(k);t.oncomplete=ok;t.onerror=ok});db.close();return 'set on the file input, and its parts cleared from this site: '+out.join(', ')})()""")

CLEAR = "indexedDB.deleteDatabase('claudopus-files')"

print('pane-file: serving on %s, process %d (stop it with: kill %d)' % (base, os.getpid(), os.getpid()))
for fid, f in files.items():
    print('file %s: %s, %d bytes, %d parts, sha256 %s' % (fid, f['name'], f['size'], len(f['parts']), f['sha'][:12]))
print("""
Steps, in one tab of the browser pane, signed in to the site:
1. For each file, navigate the tab to
     %s/go?id=<file>&i=0&to=<a plain https page on the upload page's own origin, such as https://www.example.com/robots.txt>
   The pane lands on that page with the first part in its address.
2. Run the CARRY JavaScript below in that tab, and again each time it says to (once per part, a second or so apart), until it
   says all parts are stored. The parts stay in that origin's own storage in the browser.
3. Navigate to the upload page on the same origin, open its upload step so its file input exists, and run the file's PUT
   below (one PUT for the files one input takes: join their ids in IDS). It checks each file's size and SHA-256 against the
   file here, sets the files on the file input of the dialog that shows, else the page's last one, or the one `sel` picks (a
   CSS selector instead of null), fires the input's change as a hand pick does, and clears those parts from the site's storage.
   While a dialog shows with no file input yet, it waits up to 15 seconds for one to come.
   A page that takes files only by drag and drop takes them from a drop event made with the same DataTransfer.
4. Stop this server once the site shows the file. Parts of an upload left unfinished stay on the site until CLEAR is run there.
""" % base)
print('CARRY:\n' + CARRY + '\n')
for fid, f in files.items():
    print('PUT for %s:\n%s\n' % (f['name'], PUT.replace('IDS', json.dumps([fid]))))
print('CLEAR:\n' + CLEAR + '\n')
sys.stdout.flush()

threading.Thread(target=srv.serve_forever, daemon=True).start()
while time.time() - last[0] < IDLE:
    sent = sum(len(f['sent']) for f in files.values())
    print('progress: %d/%d parts sent to the browser' % (sent, total), flush=True)
    time.sleep(10)
print('pane-file: nothing asked for 10 minutes, stopping', flush=True)
PY
