#!/bin/sh
# Shows one notification as Claudopus: bin/notify [--asks [--chime]] --title T --text X [--open URL] [--activate BUNDLE-ID] [--key K]
# --asks sends it as Claudopus Asks, the amber octopus, for work that needs the person; --chime plays its "needs you" sound with
# it, except within QUIET seconds of the last one on this Mac, so asks that arrive together are heard once.
# The app is copied to one fixed place first, so macOS knows one Claudopus whichever version of the mod is installed, and a
# click finds it again after the mod updates.
# Exit codes: 0 shown, 5 macOS is asking the person to allow Claudopus (this one is shown once they do), 2 Claudopus
# notifications are turned off, 3 none can be shown here (Linux with no desktop, Windows with no toast), anything else failed.
set -eu
# Windows, in Git for Windows' bash: a notification of Windows' own, by Windows PowerShell's toast (shown as from Windows PowerShell,
# the app Windows already knows), silent, as the mod plays its own chime; a click opens the chat's link. The words reach PowerShell
# in environment values and its script whole, so nothing of them passes through Windows' quoting of a command line. 3 when Windows
# shows none (no toast there, as on a server)
case "$(uname -s 2>/dev/null)" in
MINGW* | MSYS* | CYGWIN*)
  title='' text='' open=''
  while [ $# -gt 0 ]; do
    case $1 in
      --title) title=$2; shift 2 ;;
      --text) text=$2; shift 2 ;;
      --open) open=$2; shift 2 ;;
      --activate | --key | --sound) shift 2 ;;
      *) shift ;;
    esac
  done
  [ "$title" = '' ] && [ "$text" = '' ] && { echo on; exit 0; }
  ps1='$ErrorActionPreference = "Stop"
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] | Out-Null
[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType = WindowsRuntime] | Out-Null
$e = { param($t) [Security.SecurityElement]::Escape([string]$t) }
$open = $env:CLAUDOPUS_NOTIFY_OPEN
$launch = if ($open) { " activationType=""protocol"" launch=""" + (& $e $open) + """" } else { "" }
$xml = "<toast" + $launch + "><visual><binding template=""ToastGeneric""><text>" + (& $e $env:CLAUDOPUS_NOTIFY_TITLE) + "</text><text>" + (& $e $env:CLAUDOPUS_NOTIFY_TEXT) + "</text></binding></visual><audio silent=""true""/></toast>"
$doc = New-Object Windows.Data.Xml.Dom.XmlDocument
$doc.LoadXml($xml)
$app = "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe"
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($app).Show([Windows.UI.Notifications.ToastNotification]::new($doc))'
  # (as UTF-16 in base64, PowerShell's own way to take a script whole)
  encoded=$(printf '%s' "$ps1" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\r\n')
  CLAUDOPUS_NOTIFY_TITLE=$title CLAUDOPUS_NOTIFY_TEXT=$text CLAUDOPUS_NOTIFY_OPEN=$open MSYS2_ARG_CONV_EXCL='*' \
    powershell.exe -NoProfile -NonInteractive -EncodedCommand "$encoded" >/dev/null 2>&1 || exit 3
  exit 0
  ;;
esac
# Linux: the desktop's own notification, by notify-send, where a desktop session is seen; 3 where there is none (as in a terminal
# over SSH, where the terminal's own notification and the panel are what the person sees), so the mod says so in its log
if [ "$(uname -s)" != Darwin ]; then
  title='' text='' icon=dialog-information urgency=normal
  while [ $# -gt 0 ]; do
    case $1 in
      --asks) icon=dialog-warning urgency=critical; shift ;;
      --title) title=$2; shift 2 ;;
      --text) text=$2; shift 2 ;;
      --open | --activate | --key | --sound) shift 2 ;;
      *) shift ;;
    esac
  done
  if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || ! command -v notify-send >/dev/null 2>&1; then
    [ "$title" = '' ] && [ "$text" = '' ] && { echo unavailable; exit 0; }
    exit 3
  fi
  [ "$title" = '' ] && [ "$text" = '' ] && { echo on; exit 0; }
  exec notify-send -a Claudopus -i "$icon" -u "$urgency" -- "$title" "$text"
fi
name=Claudopus
chime=
if [ "${1:-}" = --asks ]; then
  name=ClaudopusAsks
  shift
  if [ "${1:-}" = --chime ]; then chime=1; shift; fi
fi
QUIET=5
src="$(cd "$(dirname "$0")/.." && pwd)/notifier/$name.app"
home="$HOME/Library/Application Support/Claudopus"
dest="$home/$name.app"
lock="$home/.copying"
mkdir -p "$home"

# One copy at a time: another notification copying waits up to five seconds, then this one fails to the plain notification
tries=0
until mkdir "$lock" 2>/dev/null; do
  tries=$((tries + 1))
  # A lock left by a copy that died long ago is taken over
  if [ "$tries" -gt 50 ]; then
    [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rm -rf "$lock" && continue
    exit 4
  fi
  sleep 0.1
done
trap 'rmdir "$lock" 2>/dev/null || true' EXIT
if ! diff -rq "$src" "$dest" >/dev/null 2>&1; then
  rm -rf "$dest.new"
  ditto "$src" "$dest.new"
  # A mod that came as a download carries the quarantine mark, which would stop the app when a click starts it
  xattr -dr com.apple.quarantine "$dest.new" 2>/dev/null || true
  rm -rf "$dest"
  mv "$dest.new" "$dest"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$dest" >/dev/null 2>&1 || true
fi
app="$dest/Contents/MacOS/Claudopus"
if [ "$*" = --status ]; then
  rmdir "$lock" 2>/dev/null || true
  trap - EXIT
  exec "$app" --status
fi
standing=$("$app" --status)
# Under the same lock, so two sent at once cannot both chime: the last chime's time is kept in a file, written only for one that
# will be shown now with its sound
sound=
if [ -n "$chime" ] && [ "$standing" != off ] && [ "$standing" != not-asked ]; then
  now=$(date +%s)
  last=$(cat "$home/.chimed" 2>/dev/null || echo 0)
  case $last in '' | *[!0-9]*) last=0 ;; esac
  if [ $((now - last)) -ge "$QUIET" ] || [ "$last" -gt "$now" ]; then
    sound=needs-you.wav
    echo "$now" >"$home/.chimed"
  fi
fi
rmdir "$lock" 2>/dev/null || true
trap - EXIT

case $standing in
  off) exit 2 ;;
  not-asked)
    # macOS's question stays up only while the app runs, so it waits for the answer, started by macOS apart from the mod.
    # One waits at a time; one sent meanwhile is not shown as Claudopus. It goes without the sound, which the mod plays now
    pgrep -qf "$app --title" || open -g -n -a "$dest" --args "$@"
    exit 5 ;;
esac
exec "$app" "$@" ${sound:+--sound "$sound"}
