#!/bin/bash
# Lets the person's tasks use one connector tool that Claude Code's auto mode refused them: adds `mcp__<server>__<tool>` to the
# allow list in the person's own Claude Code settings (~/.claude/settings.json), which Claude Code reads before its classifier.
#   allow-tool mcp__<server>__<tool>
# A card puts it to the person when Claude Code refuses such a call (prompts.tsx), as a command they run themselves in Terminal: a
# yes on a card is never counted by Claude Code as theirs, and only their own settings let the call through. So it runs only at a
# terminal, outside Claude Code, and changes nothing else in the file. Exit 0 added or already there, 1 not run, 2 a wrong name
set -u
rule=${1:-}
say() { printf '%s\n' "$*"; }
case $rule in
  mcp__*__*) ;;
  *) say "allow-tool: give one connector tool, as mcp__<server>__<tool>"; exit 2 ;;
esac
printf %s "$rule" | LC_ALL=C grep -Eq '^mcp__[A-Za-z0-9_-]+__[A-Za-z0-9_-]+$' || { say "allow-tool: \"$rule\" is not one connector tool"; exit 2; }
# Only the person's own hand: never from inside Claude Code, never with no terminal to type at
if [ -n "${CLAUDECODE:-}" ] || ! [ -t 0 ] || ! [ -t 1 ]; then
  say "allow-tool: only you can run this, in Terminal: it changes your own Claude Code settings. Nothing was changed."
  exit 1
fi
file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
mkdir -p "$(dirname "$file")" || exit 1
# Python where there is one; on Windows, where python3 is often missing or only the Store's stand-in, Node, else Git's own perl
if python3 -I -c 'import json' >/dev/null 2>&1; then
python3 -I - "$file" "$rule" <<'PY' || exit 1
import json, os, sys
path, rule = os.path.realpath(sys.argv[1]), sys.argv[2]
try:
    with open(path) as f:
        text = f.read()
except FileNotFoundError:
    text = ''
try:
    data = json.loads(text) if text.strip() else {}
except ValueError as err:
    print(f'allow-tool: your settings file is not valid JSON ({err}), so nothing was changed: {path}')
    sys.exit(1)
if not isinstance(data, dict):
    print(f'allow-tool: your settings file is not a JSON object, so nothing was changed: {path}')
    sys.exit(1)
perms = data.setdefault('permissions', {})
allow = perms.setdefault('allow', [])
if rule in allow:
    print(f'{rule} is already allowed in your Claude Code settings. Press Try again on the card.')
    sys.exit(0)
allow.append(rule)
tmp = f'{path}.allow-tool.{os.getpid()}'
with open(tmp, 'w') as f:
    f.write(json.dumps(data, indent=2) + '\n')
os.replace(tmp, path)
print(f'Added {rule} to your Claude Code settings: your tasks may use it from now on. Press Try again on the card.')
print(f'To take it back, remove that line from {path}.')
PY
elif command -v node >/dev/null 2>&1; then
node - "$file" "$rule" <<'JS' || exit 1
const fs = require('fs')
const [given, rule] = process.argv.slice(2)
let path = given
try { path = fs.realpathSync(given) } catch {}
let text = ''
try { text = fs.readFileSync(path, 'utf8') } catch (err) { if (err.code !== 'ENOENT') throw err }
let data
try { data = text.trim() ? JSON.parse(text) : {} } catch (err) {
  console.log(`allow-tool: your settings file is not valid JSON (${err.message}), so nothing was changed: ${path}`)
  process.exit(1)
}
if (!data || typeof data !== 'object' || Array.isArray(data)) {
  console.log(`allow-tool: your settings file is not a JSON object, so nothing was changed: ${path}`)
  process.exit(1)
}
const perms = (data.permissions ??= {})
const allow = (perms.allow ??= [])
if (allow.includes(rule)) {
  console.log(`${rule} is already allowed in your Claude Code settings. Press Try again on the card.`)
  process.exit(0)
}
allow.push(rule)
const tmp = `${path}.allow-tool.${process.pid}`
fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + '\n')
fs.renameSync(tmp, path)
console.log(`Added ${rule} to your Claude Code settings: your tasks may use it from now on. Press Try again on the card.`)
console.log(`To take it back, remove that line from ${path}.`)
JS
else
# (perl writes the settings' keys in order of their names)
/usr/bin/perl -MJSON::PP -e '
  my ($path, $rule) = @ARGV;
  my $text = "";
  if (open(my $f, "<", $path)) { local $/; $text = <$f>; close $f }
  my $json = JSON::PP->new->utf8->pretty->space_before(0)->indent_length(2)->canonical;
  my $data = $text =~ /\S/ ? eval { $json->decode($text) } : {};
  if (!defined $data) { (my $err = $@) =~ s/\s+$//; print "allow-tool: your settings file is not valid JSON ($err), so nothing was changed: $path\n"; exit 1 }
  if (ref $data ne "HASH") { print "allow-tool: your settings file is not a JSON object, so nothing was changed: $path\n"; exit 1 }
  my $allow = ($data->{permissions} //= {})->{allow} //= [];
  if (grep { $_ eq $rule } @$allow) { print "$rule is already allowed in your Claude Code settings. Press Try again on the card.\n"; exit 0 }
  push @$allow, $rule;
  my $tmp = "$path.allow-tool.$$";
  open(my $o, ">", $tmp) or exit 1; print $o $json->encode($data); close $o or exit 1;
  rename($tmp, $path) or exit 1;
  print "Added $rule to your Claude Code settings: your tasks may use it from now on. Press Try again on the card.\n";
  print "To take it back, remove that line from $path.\n";
' "$file" "$rule" || exit 1
fi
