#!/bin/bash
# Runs one command with named keys or passwords as environment variables, on this Mac or on a Mac reached over SSH.
# Each value is kept in this Mac's keychain, beside the admin passwords `admin` keeps. One not kept yet is asked once,
# in a box at the top of the Claudopus panel (a box on this Mac's screen that hides what is typed only where no chat draws one). A value only ever travels through pipes and the command's own
# environment: never in a command line, a file or a log, and the command's output comes back with every kept value hidden.
# The hiding stops a value printed by mistake; a command that sets out to change a value before printing it is not stopped.
#
#   secret NAME[,NAME...] here '<command>'          on this Mac
#   secret NAME[,NAME...] <ssh host> '<command>'    on that Mac, over SSH
#   secret [NAME] --add                             asks for NAME now (its name too when none is given), replacing a kept one
#   secret NAME --forget                            removes the kept NAME
#   secret --list                                   the names kept, never their values
#   secret --hide [--json] [NAME...]                copies stdin to stdout with each value hidden (every kept one when no
#                                                   name is given); --json hides inside the strings of one JSON text
set -u
# The command runs with the PATH it was given; the runner itself only with the system's own programs
user_path=$PATH
PATH=/usr/bin:/bin:/usr/sbin:/sbin
service=${CLAUDOPUS_SECRET_SERVICE:-claudopus-secret}
# The shortest value kept: a shorter one would be hidden inside every word that holds it
SHORTEST=4

names() {
  /usr/bin/security dump-keychain 2>/dev/null | /usr/bin/awk -v s="\"svce\"<blob>=\"$service\"" '
    /^keychain:/ { if (hit && acct != "") print acct; hit = 0; acct = "" }
    index($0, s) { hit = 1 }
    /"acct"<blob>="/ { a = $0; sub(/.*"acct"<blob>="/, "", a); sub(/"$/, "", a); acct = a }
    END { if (hit && acct != "") print acct }' | /usr/bin/sort -u
}
kept() { /usr/bin/security find-generic-password -s "$service" -a "$1" -w 2>/dev/null; }
forget() { /usr/bin/security delete-generic-password -s "$service" -a "$1" >/dev/null 2>&1; }

# Copies stdin to stdout with each named value hidden as [hidden NAME]; 1, with nothing copied, when a value cannot be
# read. The values reach perl through its environment, never a command line. Plain text goes through a line at a time, so
# output keeps flowing while the command runs; JSON is read whole and only the insides of its strings change
hide() {
  local mode=$1 name i=0 value
  shift
  (
    for name in "$@"; do
      value=$(kept "$name") && [ -n "$value" ] || { echo "$name could not be read from the keychain to hide it." >&2; exit 1; }
      i=$((i + 1))
      export "CLAUDOPUS_HIDE_$i=$value" "CLAUDOPUS_HIDE_NAME_$i=$name"
    done
    unset value
    export CLAUDOPUS_HIDE_COUNT=$i CLAUDOPUS_HIDE_MODE=$mode
    exec /usr/bin/perl -e '
      use strict;
      $| = 1;
      my @pairs;
      for my $i (1 .. $ENV{CLAUDOPUS_HIDE_COUNT}) {
        my ($v, $n) = ($ENV{"CLAUDOPUS_HIDE_$i"}, $ENV{"CLAUDOPUS_HIDE_NAME_$i"});
        delete @ENV{"CLAUDOPUS_HIDE_$i", "CLAUDOPUS_HIDE_NAME_$i"};
        push @pairs, [$v, $n];
        # the same value as a shell or a log would escape it
        (my $j = $v) =~ s/(["\\])/\\$1/g;
        push @pairs, [$j, $n] if $j ne $v;
      }
      @pairs = sort { length($b->[0]) <=> length($a->[0]) } @pairs;
      my $hit = 0;
      sub swap { my $s = shift; for (@pairs) { $hit += $s =~ s/\Q$_->[0]\E/[hidden $_->[1]]/g } $s }
      if ($ENV{CLAUDOPUS_HIDE_MODE} eq "json") {
        require JSON::PP;
        my $json = JSON::PP->new->utf8->allow_nonref;
        local $/;
        my $text = <STDIN>;
        my $walk;
        $walk = sub {
          my $x = shift;
          return [map { $walk->($_) } @$x] if ref $x eq "ARRAY";
          return {map { swap($_) => $walk->($x->{$_}) } keys %$x} if ref $x eq "HASH";
          return $x if !defined $x || ref $x;
          # a number stays a number: it is never read as text
          my $flags = B::svref_2object(\$x)->FLAGS;
          return $x if $flags & (B::SVf_IOK() | B::SVf_NOK()) && !($flags & B::SVf_POK());
          return swap($x);
        };
        require B;
        my $out = $json->encode($walk->($json->decode($text)));
        # nothing hidden: the text goes back as it came
        print $hit ? $out : $text;
      } else {
        while (my $line = <STDIN>) { print swap($line) }
      }'
  )
}

# The Claudopus panel beside the chat asks, in every chat. The request names what is needed in fields (kind admin or secret, the
# Mac as host or the key as name, and why it asks again), which the panel words itself, and the chat that asks; it holds no text that
# is shown and never a value; what is typed in the panel goes into this Mac's keychain under the request's id, and is taken from there and
# removed at once. 1 when it is cancelled there or nothing comes in 590 s, under the longest a Bash call may run; 2 when no chat
# with a panel takes the request in its first 15 s (the .told mark), as in a -p run with no chat open on this Mac
box_ask() {
  local boxes=${CLAUDOPUS_BOXES:-$HOME/.claude/claudopus/boxes} id value i status=1 taken=${CLAUDOPUS_BOX_TAKEN:-15}
  id=$(/usr/bin/uuidgen | /usr/bin/tr '[:upper:]' '[:lower:]')
  [ -n "$id" ] || return 1
  /bin/mkdir -p "$boxes" || return 1
  # $@: the request's fields as name value pairs; an empty value is left out
  /usr/bin/perl -MJSON::PP -e 'my %r = (id => shift, chat => shift, at => time() * 1000); while (@ARGV) { my ($k, $v) = splice @ARGV, 0, 2; $r{$k} = $v if length $v } print JSON::PP->new->canonical->encode(\%r), "\n"' "$id" "${CLAUDE_CODE_SESSION_ID:-}" "$@" >"$boxes/$id.part" &&
    /bin/mv "$boxes/$id.part" "$boxes/$id.json" || return 1
  trap '/bin/rm -f "$boxes/$id.json" "$boxes/$id.told"; /usr/bin/security delete-generic-password -s claudopus-box -a "$id" >/dev/null 2>&1' EXIT
  for ((i = 0; i < 590; i++)); do
    if value=$(/usr/bin/security find-generic-password -s claudopus-box -a "$id" -w 2>/dev/null); then
      printf '%s' "$value"
      unset value
      status=0
      break
    fi
    # Cancel in the panel removes the request
    [ -f "$boxes/$id.json" ] || break
    # No chat took it: no panel draws on this Mac
    [ "$i" -ge "$taken" ] && [ ! -f "$boxes/$id.told" ] && { status=2; break; }
    /bin/sleep 1
  done
  /bin/rm -f "$boxes/$id.json" "$boxes/$id.told"
  /usr/bin/security delete-generic-password -s claudopus-box -a "$id" >/dev/null 2>&1
  trap - EXIT
  return "$status"
}

# Reached over ssh, nobody sees this Mac's screen
afar() { [ -n "${CLAUDE_SSH_DAEMON_CHILD:-}${SSH_CONNECTION:-}${SSH_TTY:-}" ]; }
# A box on this Mac's screen, only where no chat draws a panel and someone can see it: $1 the text, $2 hidden or plain
screen_ask() {
  if afar; then echo "No Claudopus panel on this Mac took the request: open the panel with /claudopus in a chat here and run it again." >&2; return 1; fi
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'activate' \
    -e 'if item 2 of argv is "hidden" then' \
    -e 'return text returned of (display dialog (item 1 of argv) default answer "" with hidden answer with title "Claudopus" buttons {"Cancel", "OK"} default button "OK" with icon caution giving up after 900)' \
    -e 'end if' \
    -e 'text returned of (display dialog (item 1 of argv) default answer "" with title "Claudopus" buttons {"Cancel", "Next"} default button "Next" giving up after 900)' \
    -e 'end run' \
    "$1" "$2" 2>/dev/null
}
# The panel asks, in its own words made from the request's fields; $1 the text and $2 hidden or plain for the screen's box where no
# panel is drawn, then the fields
panel_ask() {
  local text=$1 how=$2 status
  shift 2
  box_ask kind secret "$@"
  status=$?
  [ "$status" = 2 ] || return "$status"
  screen_ask "$text" "$how"
}

# $2: why it asks again, empty, short or control
ask() {
  local name=$1 again=$2 said=''
  if [ -n "${CLAUDOPUS_SECRET_ASK:-}" ]; then "$CLAUDOPUS_SECRET_ASK" "$name"; return; fi
  case $again in short) said="That was shorter than $SHORTEST characters. " ;; control) said='That held a line break or another control character. ' ;; esac
  panel_ask "${said}Claudopus needs $name. It is kept only in this Mac's keychain, and work uses it by name, hidden in what its commands print." hidden name "$name" again "$again"
}
# Asks for one value and keeps it; 3 when nothing usable was typed. The value goes to the keychain on security's stdin,
# whose prompt would cut it at 128 characters
add() {
  local name=$1 value again='' try
  for try in 1 2 3; do
    value=$(ask "$name" "$again") || { echo "No value was typed for $name." >&2; return 3; }
    if [ "${#value}" -lt "$SHORTEST" ]; then again=short
    elif [[ $value == *[[:cntrl:]]* ]]; then again=control
    else
      printf 'add-generic-password -U -s "%s" -a "%s" -l "Claudopus: %s" -w "%s"\n' "$service" "$name" "$name" "$(printf '%s' "$value" | /usr/bin/sed 's/[\\"]/\\&/g')" | /usr/bin/security -i >/dev/null 2>&1
      local status=$?
      unset value
      [ "$status" = 0 ] || { echo "$name could not be kept in the keychain." >&2; return 6; }
      echo "$name is kept."
      return 0
    fi
  done
  unset value
  echo "No usable value was typed for $name." >&2
  return 3
}

# A name the command's shell or a program would take as its own setting is refused
valid() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
  case $1 in PATH | IFS | HOME | USER | SHELL | ENV | BASH_ENV | PS4 | SHELLOPTS | BASHOPTS | CDPATH | TMPDIR | LD_* | DYLD_* | CLAUDOPUS_*) return 1 ;; esac
}
usage() { echo "usage: secret NAME[,NAME...] here|<ssh host> '<command>' | [NAME] --add | NAME --forget | --list | --hide [--json] [NAME...]" >&2; exit 2; }

case "${1:-}" in
  --list) names; exit 0 ;;
  # A key saved by hand: a first box asks its name, then the hidden box its value
  --add)
    name=$(panel_ask "Name of the key to save, such as GITHUB_TOKEN. Work will use it by this name." plain) || { echo "No name was typed." >&2; exit 3; }
    name=$(printf '%s' "$name" | /usr/bin/tr -d '[:space:]' | /usr/bin/tr '[:lower:]-' '[:upper:]_')
    valid "$name" || { echo "$name cannot be the name of a key." >&2; exit 2; }
    add "$name"
    exit
    ;;
  --hide)
    shift
    mode=lines
    [ "${1:-}" = --json ] && { mode=json; shift; }
    if [ $# = 0 ]; then
      list=$(names)
      [ -n "$list" ] || exec cat
      IFS=$'\n' read -r -d '' -a all <<<"$list"
      set -- "${all[@]}"
    fi
    hide "$mode" "$@"
    exit
    ;;
  '' | -*) usage ;;
esac

IFS=, read -r -a wanted <<<"$1"
for name in "${wanted[@]}"; do valid "$name" || { echo "$name cannot be the name of a key." >&2; exit 2; }; done
where=${2:-}
[ -n "$where" ] || usage
if [ "$where" = --add ]; then [ "${#wanted[@]}" = 1 ] || usage; add "${wanted[0]}"; exit; fi
if [ "$where" = --forget ]; then
  [ "${#wanted[@]}" = 1 ] || usage
  forget "${wanted[0]}" && echo "${wanted[0]} is forgotten." || echo "${wanted[0]} was not kept."
  exit 0
fi
command=${3:-}
[ -n "$command" ] && [ $# = 3 ] && [ "${where#-}" = "$where" ] || usage

ssh_to() { /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -- "$where" "$@"; }
if [ "$where" != here ] && ! ssh_to true </dev/null 2>/dev/null; then
  echo "$where could not be reached over SSH." >&2
  exit 5
fi

# Each one not kept yet is asked for now
for name in "${wanted[@]}"; do
  kept "$name" >/dev/null || add "$name" >/dev/null || exit $?
done
# What is hidden: every kept value, and the wanted ones whatever the list says
all=("${wanted[@]}")
while IFS= read -r name; do [ -n "$name" ] && all+=("$name"); done < <(names)

# The values go to the command's environment through a pipe, one a line, and the command gets no stdin of its own,
# so it can never read them from there. What it prints, on either stream, comes back with every kept value hidden
feed() {
  local name value
  for name in "${wanted[@]}"; do
    value=$(kept "$name") && [ -n "$value" ] || { echo "$name could not be read from the keychain." >&2; return 1; }
    printf '%s\n' "$value"
  done
}
reads=''
for name in "${wanted[@]}"; do reads+="IFS= read -r $name && [ -n \"\$$name\" ] && export $name && "; done
if [ "$where" = here ]; then
  run() { PATH=$user_path /bin/bash -c "${reads}exec </dev/null && /bin/sh -c \"\$0\"" "$command"; }
else
  run() { ssh_to "/bin/sh -c $(printf '%q' "${reads}exec </dev/null && /bin/sh -c $(printf '%q' "$command")")"; }
fi
{ feed | run 2> >(hide lines "${all[@]}" >&2); } | hide lines "${all[@]}"
status=${PIPESTATUS[0]}
wait
exit "$status"
