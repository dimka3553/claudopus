#!/bin/bash
# Runs one command with named keys or passwords as environment variables, on this Mac or on a Mac reached over SSH.
# Each value is kept in this Mac's keychain, beside the admin passwords `admin` keeps. One not kept yet is asked once,
# in a box at the top of the Claudopus panel (a box on this Mac's screen that hides what is typed only where no chat draws one). A value only ever travels through pipes and the command's own
# environment: never in a command line, a file or a log, and the command's output comes back with every kept value hidden.
# The hiding stops a value printed by mistake; a command that sets out to change a value before printing it is not stopped.
#
#   secret NAME[,NAME...] here '<command>'          on this Mac
#   secret NAME[,NAME...] <ssh host> '<command>'    on that Mac, over SSH
#   secret [NAME] --add                             asks for NAME now (its name too when none is given), replacing a kept one
#   secret NAME --forget                            removes the kept NAME
#   secret --list                                   the names kept, never their values
#   secret --hide [--json] [--admins A,B] [NAME...] copies stdin to stdout with each value hidden (every kept one when no
#                                                   name is given); --json hides inside the strings of one JSON text; --admins
#                                                   names the kept admin passwords to hide too (none when empty), so the
#                                                   keychain is not listed for them
#   secret --marks BASE [--admins A,B] [NAME...]    prints what lets a caller tell, without a value, that a text cannot hold
#                                                   one (below); every kept key and admin password when none is named
#
# --marks prints "name<tab>NAME" for each key and "admin<tab>ACCOUNT" for each admin password it read, then for each value, and
# for the value as a shell or a log escapes it (" and \ behind a backslash, where that differs), "mark<tab>LENGTH<tab>HASH",
# and last "end". LENGTH is the value's length in BYTES and HASH a polynomial hash of its BYTES (UTF-8, as the keychain gives
# them): each byte b in turn, hash = (hash * BASE + b) mod 2147483647, from 0. BASE is the caller's own random number, 256 to
# 2097151, so the caller rolls the same hash over every window of LENGTH bytes of a text (its UTF-8 bytes) and runs --hide only
# when one matches. A value never leaves this runner; what does is its length and 31 bits of a keyed hash, which narrows a
# search for a long random key by nothing that matters, and for a short guessable password by its length and a factor of two
# thousand million: taken as the price of not starting this runner after every tool call. It fails, printing nothing a caller
# may use (no "end"), when a value cannot be read or is not UTF-8: the caller then runs --hide every time
set -u
# The command runs with the PATH it was given; the runner itself only with the system's own programs
user_path=$PATH
PATH=/usr/bin:/bin:/usr/sbin:/sbin
# The runner's own files are under the home folder the user database names for this user, never $HOME, which the caller sets (on
# Windows, in Git's bash, the profile Windows names for this user, else USERPROFILE, as bin/keyring finds it)
own_home=$(/usr/bin/perl -e 'print((getpwuid($<))[7] // "")' 2>/dev/null); case $(uname -s) in MINGW* | MSYS* | CYGWIN*) p=$(cygpath -F 40 2>/dev/null); own_home=$(cygpath -u "${p:-${USERPROFILE:-}}" 2>/dev/null) ;; esac
[ -n "$own_home" ] || own_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
[ -n "$own_home" ] && [ -d "$own_home" ] || { echo "secret: this user has no home folder" >&2; exit 1; }
# The keychain's service is fixed: nothing the caller sets points the runner at another store, such as the admin passwords
service=claudopus-secret
# The shortest value kept: a shorter one would be hidden inside every word that holds it
SHORTEST=4

# This Mac's keychain, or on Linux a folder only this user reads: bin/keyring beside this runner
case $0 in */*) keyring=${0%/*} ;; *) keyring=. ;; esac
keyring=$(cd -P "$keyring" && pwd)/keyring
# What this computer is called in what is said: a Mac, or on Linux this machine
case $(uname -s) in
  Darwin) mac=1 machine='this Mac' store="this Mac's keychain" ;;
  MINGW* | MSYS* | CYGWIN*) mac='' machine='this PC' store='a file on this PC that only you can read' ;;
  *) mac='' machine='this machine' store='a file on this machine that only you can read' ;;
esac

names() { "$keyring" list "$service" 2>/dev/null; }
# One kept value, of service $1 and account $2. On a Mac it is the keychain's own command, started once a value, with the home
# folder and the plain names bin/keyring gives it; elsewhere bin/keyring
value_of() {
  if [ -n "$mac" ]; then
    [[ $1 =~ ^[A-Za-z0-9_.@-]+$ && $2 =~ ^[A-Za-z0-9_.@-]+$ ]] && [ "$2" != . ] && [ "$2" != .. ] || return 2
    HOME=$own_home /usr/bin/security find-generic-password -s "$1" -a "$2" -w 2>/dev/null
  else
    "$keyring" get "$1" "$2" 2>/dev/null
  fi
}
kept() { value_of "$service" "$1"; }
# The kept admin passwords' accounts, one a line: the ones the caller named with --admins, else the keychain's own list
admins_known='' admins=''
admin_accounts() { if [ -n "$admins_known" ]; then printf '%s\n' "$admins"; else "$keyring" list claudopus-admin 2>/dev/null; fi; }
forget() { "$keyring" delete "$service" "$1" >/dev/null 2>&1; }

# Copies stdin to stdout with each named value hidden as [hidden NAME]; 1, with nothing copied, when a value cannot be
# read. The values reach perl through its environment, never a command line. Plain text goes through a line at a time, so
# output keeps flowing while the command runs; JSON is read whole and only the insides of its strings change. As marks it
# copies nothing and prints the names and each value's mark (the top of this file), and an admin password that cannot be
# read fails it too
hide() {
  local mode=$1 name i=0 value account
  shift
  (
    for name in "$@"; do
      value=$(kept "$name") && [ -n "$value" ] || { echo "$name could not be read from the keychain to hide it." >&2; exit 1; }
      i=$((i + 1))
      export "CLAUDOPUS_HIDE_$i=$value" "CLAUDOPUS_HIDE_NAME_$i=$name"
    done
    # The admin passwords bin/admin keeps are hidden too, whatever was named, as "admin password of <the Mac>"
    while IFS= read -r account; do
      [ -n "$account" ] || continue
      value=$(value_of claudopus-admin "$account") && [ -n "$value" ] || { [ "$mode" = marks ] && exit 1; continue; }
      i=$((i + 1))
      export "CLAUDOPUS_HIDE_$i=$value" "CLAUDOPUS_HIDE_NAME_$i=admin password of $account"
    done < <(admin_accounts)
    unset value
    export CLAUDOPUS_HIDE_COUNT=$i CLAUDOPUS_HIDE_MODE=$mode
    exec /usr/bin/perl -e '
      use strict;
      $| = 1;
      my @pairs;
      my $mode = $ENV{CLAUDOPUS_HIDE_MODE};
      my $said = "";
      for my $i (1 .. $ENV{CLAUDOPUS_HIDE_COUNT}) {
        my ($v, $n) = ($ENV{"CLAUDOPUS_HIDE_$i"}, $ENV{"CLAUDOPUS_HIDE_NAME_$i"});
        delete @ENV{"CLAUDOPUS_HIDE_$i", "CLAUDOPUS_HIDE_NAME_$i"};
        if ($mode eq "marks") {
          # the bytes of each value, hashed with whole numbers: under 2^52 at every step
          use integer;
          $said .= $n =~ /^admin password of (.*)$/s ? "admin\t$1\n" : "name\t$n\n";
          (my $j = $v) =~ s/(["\\])/\\$1/g;
          for my $s ($v, $j ne $v ? $j : ()) {
            my $text = $s;
            utf8::decode($text) or exit 1;
            my $h = 0;
            $h = ($h * $ENV{CLAUDOPUS_HIDE_BASE} + $_) % 2147483647 for unpack "C*", $s;
            $said .= "mark\t" . length($s) . "\t$h\n";
          }
          next;
        }
        # inside JSON the strings are characters, so the value is read as the characters it holds
        utf8::decode($v) if $mode eq "json";
        push @pairs, [$v, $n];
        # the same value as a shell or a log would escape it
        (my $j = $v) =~ s/(["\\])/\\$1/g;
        push @pairs, [$j, $n] if $j ne $v;
      }
      @pairs = sort { length($b->[0]) <=> length($a->[0]) } @pairs;
      my $hit = 0;
      sub swap { my $s = shift; for (@pairs) { $hit += $s =~ s/\Q$_->[0]\E/[hidden $_->[1]]/g } $s }
      if ($mode eq "marks") {
        print $said, "end\n";
      } elsif ($mode eq "json") {
        # the compiled reader where this perl has one (a Mac does), as it starts and reads faster
        my $json = (eval { require JSON::XS; JSON::XS->new } || do { require JSON::PP; JSON::PP->new })->utf8->allow_nonref;
        local $/;
        my $text = <STDIN>;
        my $walk;
        $walk = sub {
          my $x = shift;
          return [map { $walk->($_) } @$x] if ref $x eq "ARRAY";
          return {map { swap($_) => $walk->($x->{$_}) } keys %$x} if ref $x eq "HASH";
          return $x if !defined $x || ref $x;
          # a number stays a number: it is never read as text
          my $flags = B::svref_2object(\$x)->FLAGS;
          return $x if $flags & (B::SVf_IOK() | B::SVf_NOK()) && !($flags & B::SVf_POK());
          return swap($x);
        };
        require B;
        my $out = $json->encode($walk->($json->decode($text)));
        # nothing hidden: the text goes back as it came
        print $hit ? $out : $text;
      } else {
        while (my $line = <STDIN>) { print swap($line) }
      }'
  )
}

# The Claudopus panel beside the chat asks, in every chat. The request names what is needed in fields (kind admin or secret, the
# Mac as host or the key as name, and why it asks again), which the panel words itself, and the chat that asks; it holds no text that
# is shown and never a value; what is typed in the panel goes into this Mac's keychain under the request's id, and is taken from there and
# removed at once. 1 when it is cancelled there or nothing comes in 590 s, under the longest a Bash call may run; 2 when no chat
# with a panel takes the request in its first 15 s (the .told mark), as in a -p run with no chat open on this Mac; 4 when the person
# gave a response instead of the value: the panel leaves their words beside the request (.reply), then removes the request, and
# they are printed on stderr for the command's caller to read and act on
box_ask() {
  local boxes=${CLAUDOPUS_BOXES:-$own_home/.claude/claudopus/boxes} id value i status=1 taken=${CLAUDOPUS_BOX_TAKEN:-15}
  # uuidgen, or Linux's own where it is not installed, else one made of random bytes (Git's bash on Windows has neither)
  id=$({ /usr/bin/uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n' | sed -E 's/^(.{8})(.{4})(.{4})(.{4})(.{12})$/\1-\2-\3-\4-\5\n/'; } | /usr/bin/tr '[:upper:]' '[:lower:]')
  [ -n "$id" ] || return 1
  /bin/mkdir -p "$boxes" || return 1
  # $@: the request's fields as name value pairs; an empty value is left out
  /usr/bin/perl -MJSON::PP -e 'my %r = (id => shift, chat => shift, at => time() * 1000); while (@ARGV) { my ($k, $v) = splice @ARGV, 0, 2; $r{$k} = $v if length $v } print JSON::PP->new->canonical->encode(\%r), "\n"' "$id" "${CLAUDE_CODE_SESSION_ID:-}" "$@" >"$boxes/$id.part" &&
    /bin/mv "$boxes/$id.part" "$boxes/$id.json" || return 1
  trap '/bin/rm -f "$boxes/$id.json" "$boxes/$id.told" "$boxes/$id.reply"; "$keyring" delete claudopus-box "$id" >/dev/null 2>&1' EXIT
  for ((i = 0; i < 590; i++)); do
    if value=$("$keyring" get claudopus-box "$id" 2>/dev/null); then
      printf '%s' "$value"
      unset value
      status=0
      break
    fi
    # Cancel in the panel removes the request; a response left beside it is the person's answer instead
    if [ ! -f "$boxes/$id.json" ]; then
      if [ -f "$boxes/$id.reply" ]; then
        /bin/cat "$boxes/$id.reply" >&2
        status=4
      fi
      break
    fi
    # No chat took it: no panel draws on this Mac
    [ "$i" -ge "$taken" ] && [ ! -f "$boxes/$id.told" ] && { status=2; break; }
    /bin/sleep 1
  done
  /bin/rm -f "$boxes/$id.json" "$boxes/$id.told" "$boxes/$id.reply"
  "$keyring" delete claudopus-box "$id" >/dev/null 2>&1
  trap - EXIT
  return "$status"
}

# Reached over ssh, nobody sees this Mac's screen
afar() { [ -n "${CLAUDE_SSH_DAEMON_CHILD:-}${SSH_CONNECTION:-}${SSH_TTY:-}" ]; }
# A box on this Mac's screen, only where no chat draws a panel and someone can see it: $1 the text, $2 hidden or plain
screen_ask() {
  # Linux has no box of its own to ask on the screen: there the panel is the one place it is asked
  if afar || [ "$machine" != 'this Mac' ]; then echo "No Claudopus panel on $machine took the request: open the panel with /claudopus in a chat here and run it again." >&2; return 1; fi
  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'activate' \
    -e 'if item 2 of argv is "hidden" then' \
    -e 'return text returned of (display dialog (item 1 of argv) default answer "" with hidden answer with title "Claudopus" buttons {"Cancel", "OK"} default button "OK" with icon caution giving up after 900)' \
    -e 'end if' \
    -e 'text returned of (display dialog (item 1 of argv) default answer "" with title "Claudopus" buttons {"Cancel", "Next"} default button "Next" giving up after 900)' \
    -e 'end run' \
    "$1" "$2" 2>/dev/null
}
# The panel asks, in its own words made from the request's fields; $1 the text and $2 hidden or plain for the screen's box where no
# panel is drawn, then the fields
panel_ask() {
  local text=$1 how=$2 status
  shift 2
  box_ask kind secret "$@"
  status=$?
  [ "$status" = 2 ] || return "$status"
  screen_ask "$text" "$how"
}

# $2: why it asks again, empty, short or control
ask() {
  local name=$1 again=$2 said=''
  if [ -n "${CLAUDOPUS_SECRET_ASK:-}" ]; then "$CLAUDOPUS_SECRET_ASK" "$name"; return; fi
  case $again in short) said="That was shorter than $SHORTEST characters. " ;; control) said='That held a line break or another control character. ' ;; esac
  panel_ask "${said}Claudopus needs $name. It is kept only in $store, and work uses it by name, hidden in what its commands print." hidden name "$name" again "$again"
}
# Asks for one value and keeps it; 3 when nothing usable was typed. The value goes to the keychain on security's stdin,
# whose prompt would cut it at 128 characters
add() {
  local name=$1 value again='' try
  for try in 1 2 3; do
    value=$(ask "$name" "$again") || {
      got=$?
      # A response instead of the value: its words are already on stderr
      [ "$got" = 4 ] && { echo "$name was not given, so the command did not run. Act on the response above." >&2; return 4; }
      echo "No value was typed for $name." >&2
      return 3
    }
    if [ "${#value}" -lt "$SHORTEST" ]; then again=short
    elif [[ $value == *[[:cntrl:]]* ]]; then again=control
    else
      printf '%s\n' "$value" | "$keyring" set "$service" "$name" "Claudopus: $name" >/dev/null 2>&1
      local status=$?
      unset value
      [ "$status" = 0 ] || { echo "$name could not be kept in $store." >&2; return 6; }
      echo "$name is kept."
      return 0
    fi
  done
  unset value
  echo "No usable value was typed for $name." >&2
  return 3
}

# A name the command's shell or a program would take as its own setting is refused
valid() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
  case $1 in PATH | IFS | HOME | USER | SHELL | ENV | BASH_ENV | PS4 | SHELLOPTS | BASHOPTS | CDPATH | TMPDIR | LD_* | DYLD_* | CLAUDOPUS_*) return 1 ;; esac
  # and what Windows itself reads, in any case, as Windows does
  case $(printf '%s' "$1" | /usr/bin/tr '[:lower:]' '[:upper:]') in USERPROFILE | APPDATA | LOCALAPPDATA | TEMP | TMP | SYSTEMROOT | SYSTEMDRIVE | WINDIR | COMSPEC | PATHEXT | PROGRAMFILES | HOMEDRIVE | HOMEPATH | MSYSTEM) return 1 ;; esac
}
usage() { echo "usage: secret NAME[,NAME...] here|<ssh host> '<command>' | [NAME] --add | NAME --forget | --list | --hide [--json] [--admins A,B] [NAME...] | --marks BASE [--admins A,B] [NAME...]" >&2; exit 2; }

case "${1:-}" in
  --list) names; exit 0 ;;
  # A key saved by hand: a first box asks its name, then the hidden box its value
  --add)
    name=$(panel_ask "Name of the key to save, such as GITHUB_TOKEN. Work will use it by this name." plain) || { [ $? = 4 ] && exit 4; echo "No name was typed." >&2; exit 3; }
    name=$(printf '%s' "$name" | /usr/bin/tr -d '[:space:]' | /usr/bin/tr '[:lower:]-' '[:upper:]_')
    valid "$name" || { echo "$name cannot be the name of a key." >&2; exit 2; }
    add "$name"
    exit
    ;;
  --hide | --marks)
    mode=lines
    if [ "$1" = --marks ]; then
      mode=marks
      [[ ${2:-} =~ ^[0-9]{3,7}$ ]] && [ "$2" -ge 256 ] && [ "$2" -le 2097151 ] || usage
      export CLAUDOPUS_HIDE_BASE=$2
      shift
    fi
    shift
    [ "${1:-}" = --json ] && [ "$mode" = lines ] && { mode=json; shift; }
    if [ "${1:-}" = --admins ]; then
      [ $# -ge 2 ] || usage
      admins_known=1 admins=${2//,/$'\n'}
      shift 2
    fi
    if [ $# = 0 ] && [ "$mode" = marks ] && [ -z "$admins_known" ]; then
      # Every name in one listing of the keychain; one that does not answer fails it
      listing=$("$keyring" entries 2>/dev/null) || exit 1
      admins_known=1
      while IFS=$'\t' read -r one account; do
        case $one in
          "$service") set -- "$@" "$account" ;;
          claudopus-admin) admins+=${admins:+$'\n'}$account ;;
        esac
      done <<<"$listing"
    elif [ $# = 0 ]; then
      list=$(names)
      if [ -n "$list" ]; then
        IFS=$'\n' read -r -d '' -a all <<<"$list"
        set -- "${all[@]}"
      fi
    fi
    hide "$mode" "$@"
    exit
    ;;
  '' | -*) usage ;;
esac

IFS=, read -r -a wanted <<<"$1"
for name in "${wanted[@]}"; do valid "$name" || { echo "$name cannot be the name of a key." >&2; exit 2; }; done
where=${2:-}
[ -n "$where" ] || usage
if [ "$where" = --add ]; then [ "${#wanted[@]}" = 1 ] || usage; add "${wanted[0]}"; exit; fi
if [ "$where" = --forget ]; then
  [ "${#wanted[@]}" = 1 ] || usage
  forget "${wanted[0]}" && echo "${wanted[0]} is forgotten." || echo "${wanted[0]} was not kept."
  exit 0
fi
command=${3:-}
[ -n "$command" ] && [ $# = 3 ] && [ "${where#-}" = "$where" ] || usage

ssh_to() { /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -- "$where" "$@"; }
if [ "$where" != here ] && ! ssh_to true </dev/null 2>/dev/null; then
  echo "$where could not be reached over SSH." >&2
  exit 5
fi

# Each one not kept yet is asked for now
for name in "${wanted[@]}"; do
  kept "$name" >/dev/null || add "$name" >/dev/null || exit $?
done
# What is hidden: every kept value, and the wanted ones whatever the list says
all=("${wanted[@]}")
while IFS= read -r name; do [ -n "$name" ] && all+=("$name"); done < <(names)
# (the admin passwords' accounts are listed once for both streams)
admins=$("$keyring" list claudopus-admin 2>/dev/null) admins_known=1

# The values go to the command's environment through a pipe, one a line, and the command gets no stdin of its own,
# so it can never read them from there. What it prints, on either stream, comes back with every kept value hidden
feed() {
  local name value
  for name in "${wanted[@]}"; do
    value=$(kept "$name") && [ -n "$value" ] || { echo "$name could not be read from the keychain." >&2; return 1; }
    printf '%s\n' "$value"
  done
}
reads=''
for name in "${wanted[@]}"; do reads+="IFS= read -r $name && [ -n \"\$$name\" ] && export $name && "; done
if [ "$where" = here ]; then
  run() { PATH=$user_path /bin/bash -c "${reads}exec </dev/null && /bin/sh -c \"\$0\"" "$command"; }
else
  run() { ssh_to "/bin/sh -c $(printf '%q' "${reads}exec </dev/null && /bin/sh -c $(printf '%q' "$command")")"; }
fi
{ feed | run 2> >(hide lines "${all[@]}" >&2); } | hide lines "${all[@]}"
status=${PIPESTATUS[0]}
wait
exit "$status"
