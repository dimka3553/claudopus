#!/bin/bash
# Brings Claudopus back in a chat where Claude's engine switched it off.
#
# revive <memory folder>
#
# Claude's engine runs every add-on's hooks on one shared helper. When the helper gives no answer for five seconds while one of an
# add-on's hooks is answering, the engine switches that add-on off, and it stays off in that chat until the person types
# /reload-plugins. The engine loads an add-on again by itself when one of its own settings changes. So each chat's Claudopus writes
# <memory>/keep/<chat>.beat every few seconds: the chat's process, the key its copy of Claudopus has in the settings, the
# settings file it reads, a tab apart, and on a line of its own the load that wrote it. One of these runs on the Mac at a time, the
# newest copy's. When a beat goes quiet while its chat's process still runs, it changes that copy's own "revived" setting in that
# file, and the engine loads Claudopus again: in every chat that copy runs in, as an update does. A chat that does not come back
# after a few tries is left as it is until its beat moves again. What it did is in <memory>/keep/revive.log.
#
# A beat names the load of Claudopus that wrote it. One that moves again from the same load after a change was never switched off:
# its chat's process was only slow (16 Nov, from 20:26 UTC: one chat's process hardly ran for over an hour, and eleven changes
# reloaded the three other chats while that chat's own copy, never off, went on as it was). Such a load is left alone until a newer
# load beats, or it has gone SLOW_KEEP without a stall (then it is treated as any other again), or its beat stays quiet for
# SLOW_QUIET (a switched-off copy never beats again, so it reaches that), and then has its tries as any other: a slow process is
# just when the engine switches an add-on off. So one chat that stalls on and off costs a reload only per stall of SLOW_QUIET
set -u
# (revive --change <settings file> <key> <time>: only the change below, as the tests try it)
if [ "${1:-}" = --change ]; then CHANGE_ONLY=1; else CHANGE_ONLY=; fi
mem=${1:?memory folder}
dir="$mem/keep"
[ -n "$CHANGE_ONLY" ] || mkdir -p "$dir" || exit 1
# How often to look, how quiet a beat may be (longer just after the Mac woke), how long between two changes, how many tries a chat
# gets before it is left
STEP=${CLAUDOPUS_REVIVE_STEP:-3}
QUIET=${CLAUDOPUS_REVIVE_QUIET:-10}
WOKE_QUIET=${CLAUDOPUS_REVIVE_WOKE_QUIET:-60}
GAP=${CLAUDOPUS_REVIVE_GAP:-60}
TRIES=${CLAUDOPUS_REVIVE_TRIES:-3}
# How long a chat's fresh load has to write its first beat before it is tried again: a busy Mac starts a load slowly, and a change
# made while it starts only loads it once more and cuts off the chat's turn again (27 Nov: three changes in three minutes, while
# the chat's Claudopus was running all along)
RELOAD_WAIT=${CLAUDOPUS_REVIVE_RELOAD_WAIT:-300}
SLOW_QUIET=${CLAUDOPUS_REVIVE_SLOW_QUIET:-300}
SLOW_KEEP=${CLAUDOPUS_REVIVE_SLOW_KEEP:-1800}
# With no chat beating for this long, it ends
IDLE=${CLAUDOPUS_REVIVE_IDLE:-600}
# (in UTC, as Claudopus's own log.md, so the two are read side by side)
log() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >> "$dir/revive.log"; }
now() { date +%s; }
# (GNU stat where it is there: its -f reads the file system and succeeds, so the BSD form would give nonsense on Linux). Which one is
# found once, so a look at a beat on a Mac starts one process, not a failed one first
if stat -c %Y / >/dev/null 2>&1; then mtime() { stat -c %Y "$1" 2>/dev/null; }; mtimes() { stat -c '%Y %n' "$@" 2>/dev/null; }; else mtime() { stat -f %m "$1" 2>/dev/null; }; mtimes() { stat -f '%m %N' "$@" 2>/dev/null; }; fi
me="$0"
# Windows, in Git for Windows' bash: a chat's process is a Windows process, which kill and ps never see, so tasklist says which run;
# the watchers are Git's own processes, whose command lines are in /proc
win=; case "$(uname -s 2>/dev/null)" in MINGW* | MSYS* | CYGWIN*) win=1 ;; esac
argsOf() { if [ -n "$win" ]; then { tr '\0' ' ' < "/proc/$1/cmdline"; } 2>/dev/null; else ps -o args= -p "$1" 2>/dev/null; fi; }
# (once a look: the numbers of every Windows process; none at all when tasklist does not answer, and then every chat is taken to run)
running=
windowsLook() { running=$(tasklist //FO CSV //NH 2>/dev/null | cut -d, -f2 | tr -d '"\r'); [ -n "$running" ] || running=all; }
chatRuns() {
  if [ -z "$win" ]; then kill -0 "${1:-0}" 2>/dev/null; return; fi
  case "${1:-}" in '' | *[!0-9]*) return 1 ;; esac
  [ "$running" = all ] || printf '%s\n' "$running" | grep -qx "$1"
}

# One at a time, the newest copy's: one already running from this same file, unchanged since it started, is left to run; one from
# another copy (an older version), or from this file before an update rewrote it (a copy loaded from a folder keeps one path for
# every version), is ended, and this one takes over. revive.pid holds the watcher's process and its file's time
if [ -z "$CHANGE_ONLY" ]; then
  was=$(head -n 1 "$dir/revive.pid" 2>/dev/null)
  wasfile=$(sed -n 2p "$dir/revive.pid" 2>/dev/null)
  file=$(mtime "$me")
  if [ -n "$was" ] && [ "$was" != "$$" ] && kill -0 "$was" 2>/dev/null; then
    args=$(argsOf "$was")
    case "$args" in
      *"$me $mem"*) [ -n "$file" ] && [ "$wasfile" = "$file" ] && exit 0; kill "$was" 2>/dev/null ;;
      *bin/revive*) kill "$was" 2>/dev/null ;;
    esac
  fi
  printf '%s\n%s\n' "$$" "$file" > "$dir/revive.pid"
fi
mine() { local p=; { read -r p < "$dir/revive.pid"; } 2>/dev/null; [ "$p" = "$$" ]; }

# One key's "revived" option set in one settings file with the system's own JSON (JavaScript on macOS, Python on Linux, Git's Perl
# on Windows, where python3 is often missing or the Store's stand-in), every other key as it was. A key of an installed copy is
# changed only while enabledPlugins turns it on; one loaded from a folder (claudopus@inline) has no entry there. Prints "set", or
# "off"; fails when the file cannot be read as JSON or holds a number JavaScript cannot carry whole, which it leaves as it is
change() { # <settings file> <key> <time>
  if [ -n "$win" ] || [ "${CLAUDOPUS_REVIVE_PERL:-}" = 1 ]; then
    changePerl "$@"
  elif [ -x /usr/bin/osascript ]; then
    /usr/bin/osascript -l JavaScript - "$1" "$2" "$3" <<'JS' 2>/dev/null
ObjC.import('Foundation')
function run(argv) {
  const path = $(argv[0]).stringByResolvingSymlinksInPath.js
  const text = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null)
  if (text.isNil()) throw new Error('unread')
  // A number of more than 15 digits would come back changed
  if (/[-:\[,\s]\d{16,}|\d\.\d{16,}/.test(text.js)) throw new Error('numbers')
  const d = JSON.parse(text.js)
  const key = argv[1]
  if (key !== 'claudopus@inline' && (d.enabledPlugins || {})[key] !== true) return 'off'
  if (!d.pluginConfigs || typeof d.pluginConfigs !== 'object') d.pluginConfigs = {}
  if (!d.pluginConfigs[key] || typeof d.pluginConfigs[key] !== 'object') d.pluginConfigs[key] = {}
  const one = d.pluginConfigs[key]
  if (!one.options || typeof one.options !== 'object') one.options = {}
  one.options.revived = argv[2]
  if (!$(JSON.stringify(d, null, 2) + '\n').writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null)) throw new Error('unwritten')
  return 'set'
}
JS
  else
    python3 - "$1" "$2" "$3" <<'PY' 2>/dev/null
import json, os, re, sys, tempfile
path, key, at = os.path.realpath(sys.argv[1]), sys.argv[2], sys.argv[3]
with open(path) as f: text = f.read()
# As on a Mac: a number of more than 15 digits is left as it is
if re.search(r'[-:\[,\s]\d{16,}|\d\.\d{16,}', text): sys.exit(1)
d = json.loads(text)
if key != 'claudopus@inline' and (d.get('enabledPlugins') or {}).get(key) is not True: print('off'); sys.exit(0)
if not isinstance(d.get('pluginConfigs'), dict): d['pluginConfigs'] = {}
if not isinstance(d['pluginConfigs'].get(key), dict): d['pluginConfigs'][key] = {}
one = d['pluginConfigs'][key]
if not isinstance(one.get('options'), dict): one['options'] = {}
one['options']['revived'] = at
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, 'w') as f: f.write(json.dumps(d, indent=2) + '\n')
os.chmod(tmp, os.stat(path).st_mode & 0o777); os.replace(tmp, path)
print('set')
PY
  fi
}

# Perl's own JSON reads a file into hashes, which lose its keys' order, so the file is read here as it is written: each object a
# list of its keys and values in order, each string and number kept as its own text, written back as JavaScript's JSON.stringify
# with two spaces would write it. A file held open elsewhere a moment is tried again
changePerl() {
  /usr/bin/perl - "$1" "$2" "$3" <<'PL' 2>/dev/null
use strict; use warnings;
my ($path, $key, $at) = @ARGV;
open my $in, '<:raw', $path or exit 1; local $/; my $text = <$in>; close $in;
exit 1 if !defined $text || $text =~ /[-:\[,\s]\d{16,}|\d\.\d{16,}/;
my $s = $text;
sub ws { $s =~ /\G[ \t\r\n]*/gc }
sub value {
  ws();
  if ($s =~ /\G\{/gc) { my @kv; ws(); return ['o', \@kv] if $s =~ /\G\}/gc;
    while (1) { ws(); $s =~ /\G("(?:[^"\\]|\\.)*")/gc or die; my $k = $1; ws(); $s =~ /\G:/gc or die; push @kv, [$k, value()]; ws(); next if $s =~ /\G,/gc; $s =~ /\G\}/gc or die; return ['o', \@kv] } }
  if ($s =~ /\G\[/gc) { my @a; ws(); return ['a', \@a] if $s =~ /\G\]/gc;
    while (1) { push @a, value(); ws(); next if $s =~ /\G,/gc; $s =~ /\G\]/gc or die; return ['a', \@a] } }
  return ['v', $1] if $s =~ /\G("(?:[^"\\]|\\.)*"|-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?|true|false|null)/gc;
  die;
}
my $d = eval { my $v = value(); ws(); die if pos($s) != length $s; $v } or exit 1;
exit 1 unless $d->[0] eq 'o';
sub quoted { my $t = shift; $t =~ s/(["\\])/\\$1/g; $t =~ s/\n/\\n/g; $t =~ s/\t/\\t/g; $t =~ s/\r/\\r/g; return qq("$t") }
sub get { my ($o, $k) = @_; for (@{ $o->[1] }) { return $_ if $_->[0] eq $k } return undef }
sub put { my ($o, $k, $v) = @_; my $e = get($o, $k); if ($e) { $e->[1] = $v } else { push @{ $o->[1] }, [$k, $v] } return $v }
my $qk = quoted($key);
if ($key ne 'claudopus@inline') {
  my $en = get($d, '"enabledPlugins"'); my $on = $en && $en->[1][0] eq 'o' ? get($en->[1], $qk) : undef;
  unless ($on && $on->[1][0] eq 'v' && $on->[1][1] eq 'true') { print "off\n"; exit 0 }
}
my $obj = sub { my ($o, $k) = @_; my $e = get($o, $k); return $e && $e->[1][0] eq 'o' ? $e->[1] : put($o, $k, ['o', []]) };
my $one = $obj->($obj->($obj->($d, '"pluginConfigs"'), $qk), '"options"');
put($one, '"revived"', ['v', quoted($at)]);
sub out { my ($v, $in) = @_; my $n = "$in  ";
  return $v->[1] if $v->[0] eq 'v';
  return $v->[0] eq 'o' ? '{}' : '[]' unless @{ $v->[1] };
  return "{\n" . join(",\n", map { "$n$_->[0]: " . out($_->[1], $n) } @{ $v->[1] }) . "\n$in}" if $v->[0] eq 'o';
  return "[\n" . join(",\n", map { $n . out($_, $n) } @{ $v->[1] }) . "\n$in]";
}
my $tmp = "$path.revive-$$";
open my $out, '>:raw', $tmp or exit 1; print $out out($d, '') . "\n"; close $out or exit 1;
for (1 .. 10) { if (rename $tmp, $path) { print "set\n"; exit 0 } select(undef, undef, undef, 0.2) }
unlink $tmp; exit 1;
PL
}

[ -n "$CHANGE_ONLY" ] && { change "$2" "$3" "$4"; exit; }
log "watching the chats' beats (pid $$)"
# The last change, kept on disk: a watcher that takes over keeps to GAP after its predecessor's change
changed=$(cat "$dir/revive.lastchange" 2>/dev/null); case "$changed" in ''|*[!0-9]*) changed=0 ;; esac
last=$(now) idle=$(now) woke=0
# Each look starts as few processes as it can, as it runs every few seconds for days, on battery too: the time from the shell's own
# count of seconds (by the wall clock, so a Mac that slept still shows the gap), files read and names cut by the shell itself
base=$(( $(now) - SECONDS ))
# The wait between two looks is the shell's own where it can be: a timed read of a pipe nobody writes to, held open by this process
# alone (its name is removed at once), for a STEP of whole seconds, which is all the Mac's bash takes. A read that comes back early
# is no wait at all, so it sleeps instead, and after three of those for good
nap() { sleep "$STEP"; }
pipe="$dir/revive.$$.wait"
case "$STEP" in
  ''|*[!0-9]*|0) ;;
  *)
    if mkfifo "$pipe" 2>/dev/null && exec 9<>"$pipe"; then
      early=0
      nap() {
        local from=$SECONDS
        read -r -t "$STEP" -u 9 _ 2>/dev/null
        [ $((SECONDS - from)) -ge "$STEP" ] && return
        early=$((early + 1)); [ "$early" -ge 3 ] && nap() { sleep "$STEP"; }
        sleep "$STEP"
      }
    fi
    rm -f "$pipe"
    ;;
esac
while mine; do
  nap
  t=$((base + SECONDS))
  # A Mac that slept leaves every beat quiet when it wakes: the chats get longer to write theirs again
  [ $((t - last)) -gt $((STEP * 3 + 5)) ] && woke=$t
  last=$t
  any=0
  if [ -n "$win" ]; then for b in "$dir"/*.beat; do [ -f "$b" ] && { windowsLook; break; }; done; fi
  # Every beat's time in one look: one process a pass however many chats are open, and none with no beat
  set -- "$dir"/*.beat
  times=''; [ -e "$1" ] && times=$(mtimes "$@")
  while read -r -u 8 m beat; do
    [ -f "$beat" ] || continue
    sid=${beat##*/}; sid=${sid%.beat}
    # (the load on a line of its own: a watcher of an older version, still running, reads the first line as before). A beat with
    # no load line (half written, or from an older version) says nothing of its load, and the slow mark is left as it is
    load=''
    { IFS=$'\t' read -r pid key settings; read -r load; } < "$beat" 2>/dev/null
    # A chat whose process has ended has no Claudopus to bring back
    if ! chatRuns "${pid:-}"; then rm -f "$beat" "$dir/$sid.revived" "$dir/$sid.gaveup" "$dir/$sid.changed" "$dir/$sid.slow"; continue; fi
    any=1
    case "$m" in ''|*[!0-9]*) continue ;; esac
    quiet=$((t - m))
    # The slow mark: the load, and when it was last seen stalled
    slow='' stalled=''
    [ -f "$dir/$sid.slow" ] && { read -r slow; read -r stalled; } < "$dir/$sid.slow" 2>/dev/null
    case "$stalled" in ''|*[!0-9]*) stalled=$t ;; esac
    # A newer load: the slow one is gone
    [ -n "$slow" ] && [ -n "$load" ] && [ "$slow" != "$load" ] && { rm -f "$dir/$sid.slow"; slow=''; }
    if [ "$quiet" -lt "$QUIET" ]; then
      was=''; [ -f "$dir/$sid.changed" ] && read -r was < "$dir/$sid.changed" 2>/dev/null
      if [ -n "$load" ] && [ "$was" = "$load" ]; then
        # Beating again from the load that beat before the change: it was never off, and the change only reloaded the other chats
        log "chat $sid: beats again from the same load, so Claudopus was not off: its process was slow; it is left alone until it loads anew, goes $SLOW_KEEP s without a stall or stays quiet $SLOW_QUIET s"
        printf '%s\n%s\n' "$load" "$t" > "$dir/$sid.slow"
      elif [ -n "$slow" ] && [ $((t - stalled)) -ge "$SLOW_KEEP" ]; then
        rm -f "$dir/$sid.slow"; log "chat $sid: no stall for $SLOW_KEEP s; treated as any other"
      fi
      # Beating: a chat that came back starts its tries afresh
      if [ -e "$dir/$sid.revived" ] || [ -e "$dir/$sid.gaveup" ] || [ -e "$dir/$sid.changed" ]; then rm -f "$dir/$sid.revived" "$dir/$sid.gaveup" "$dir/$sid.changed"; fi
      continue
    fi
    if [ -n "$slow" ]; then
      # Stalled again: the mark is kept from now, and it waits SLOW_QUIET
      printf '%s\n%s\n' "$slow" "$t" > "$dir/$sid.slow"
      [ "$quiet" -lt "$SLOW_QUIET" ] && continue
    fi
    [ $((t - woke)) -lt "$WOKE_QUIET" ] && continue
    [ $((t - changed)) -lt "$GAP" ] && continue
    # Left after its tries, until its beat moves again
    [ -f "$dir/$sid.gaveup" ] && continue
    case "${key:-}" in claudopus@*) ;; *) continue ;; esac
    [ -f "${settings:-}" ] || continue
    tries=0; [ -f "$dir/$sid.revived" ] && tries=$(wc -l < "$dir/$sid.revived" | tr -d ' ')
    # Changed lately: its fresh load is given RELOAD_WAIT to beat before another try
    tried=$(tail -n 1 "$dir/$sid.revived" 2>/dev/null | cut -d ' ' -f 1); case "$tried" in ''|*[!0-9]*) tried=0 ;; esac
    [ $((t - tried)) -lt "$RELOAD_WAIT" ] && continue
    if [ "${tries:-0}" -ge "$TRIES" ]; then
      log "chat $sid: Claudopus did not come back after $tries tries; left as it is until it beats again"
      : > "$dir/$sid.gaveup"
      continue
    fi
    changed=$t
    printf '%s\n' "$t" > "$dir/revive.lastchange"
    printf '%s %s\n' "$t" "$quiet" >> "$dir/$sid.revived"
    said=$(change "$settings" "$key" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')") || { log "chat $sid: quiet $quiet s, but its settings file could not be changed (not plain JSON, or a number too long to keep); left as it is"; : > "$dir/$sid.gaveup"; continue; }
    if [ "$said" = off ]; then log "chat $sid: quiet $quiet s, and $key is turned off in the settings: nothing done"; : > "$dir/$sid.gaveup"; continue; fi
    # (only a change made: the load it was made for, whose beating again proves that chat was never off)
    [ -n "$load" ] && printf '%s\n' "$load" > "$dir/$sid.changed"
    log "chat $sid: quiet $quiet s while its process $pid runs: the setting of $key changed, so Claude loads it again"
  done 8<<<"$times"
  [ "$any" = 1 ] && idle=$t
  [ $((t - idle)) -ge "$IDLE" ] && { log "no chat beating for $IDLE s: ended"; break; }
done
mine && rm -f "$dir/revive.pid"
exit 0
