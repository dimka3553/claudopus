#!/bin/bash
# Keeps a chat's work going on this Mac when the Claude app on another Mac ends the chat's process here.
#
# keep <engine pid> <session id> <folder> <memory folder>
#
# Claudopus starts one for each load of a chat the app runs on this Mac over SSH, in a session of its own, so it outlives the
# chat's process. It waits for that process to end. When it ends while work of the chat's is at work (the mod keeps
# <memory>/keep/<session>.json true) and the app does not start the chat again within a minute, it starts the chat again here as
# one of Claude Code's own background sessions: under this Mac's own sign-in, with the same conversation, model, effort and
# permission mode. Claude Code starts its cut-off work again by itself there, and Claudopus marks it and says so. The copy is
# stopped once its work is done and idle a while, or as soon as the app starts the chat again, so the app finds it free.
# What it did is in <memory>/keep/<session>.log; where it stands in <memory>/keep/<session>.state.
set -u
pid=${1:?engine pid} sid=${2:?session id} cwd=${3:?folder} mem=${4:?memory folder}
case "$sid" in *[!A-Za-z0-9-]*) exit 2 ;; esac
dir="$mem/keep"
mkdir -p "$dir" || exit 1
# How long the app has to start the chat again itself, how often to look, how long finished work rests before its copy stops
GRACE=${CLAUDOPUS_KEEP_GRACE:-60}
STEP=${CLAUDOPUS_KEEP_STEP:-2}
REST=${CLAUDOPUS_KEEP_REST:-120}
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$dir/$sid.log"; }
field() { /usr/bin/plutil -extract "$1" raw -o - "$2" 2>/dev/null; }
now() { date +%s; }

# The newest keeper of a chat is the one that acts: a load after this one starts its own
me="$$ $pid"
printf '%s\n' "$me" > "$dir/$sid.keeper"
mine() { [ "$(cat "$dir/$sid.keeper" 2>/dev/null)" = "$me" ]; }

# The process's own model, effort and permission mode, read while it runs
args=$(ps -o args= -p "$pid" 2>/dev/null) || { log "process $pid was gone before it was watched"; exit 0; }
opt() { printf '%s\n' "$args" | tr ' ' '\n' | awk -v k="--$1" 'f { print; exit } $0 == k { f = 1 } index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }'; }
model=$(opt model) effort=$(opt effort) mode=$(opt permission-mode) sources=$(opt setting-sources)
# Its plugin folders too, such as those the app copies here from the other Mac, so the copy runs with the same plugins
plugins=$(printf '%s\n' "$args" | tr ' ' '\n' | awk 'f { print; f = 0; next } $0 == "--plugin-dir" { f = 1 } index($0, "--plugin-dir=") == 1 { print substr($0, 14) }')
log "watching process $pid in $cwd (model ${model:-default}, effort ${effort:-default}, mode ${mode:-default})"

while kill -0 "$pid" 2>/dev/null; do sleep "$STEP"; done
gone=$(now)
mine || exit 0
count=$(field count "$dir/$sid.json")
title=$(field title "$dir/$sid.json")
if [ "${count:-0}" -eq 0 ] 2>/dev/null || [ -z "$count" ]; then log "process $pid ended with nothing at work: not kept"; exit 0; fi
log "process $pid ended with $count piece(s) of work at work"
# When it ended, for the cards: the next load of the chat, here or in the app, marks that work cut off from then
printf '{"cutAt":%s,"count":%s}\n' "$((gone * 1000))" "$count" > "$dir/$sid.state"

# Another process of the same chat: the app started it again itself, or someone resumed it
again() { pgrep -f -- "--resume[= ]$sid" >/dev/null 2>&1; }
waited=0
while [ "$waited" -lt "$GRACE" ]; do
  if again; then log "the chat was started again by the app within ${waited}s: not kept"; exit 0; fi
  mine || exit 0
  sleep "$STEP"; waited=$((waited + STEP))
done

# Started as Claude Code's own background session, with none of the app's settings: this Mac's sign-in, its PATH, its plugins
claude=""
for one in "$HOME/.local/bin/claude" /opt/homebrew/bin/claude /usr/local/bin/claude; do [ -x "$one" ] && { claude=$one; break; }; done
[ -n "$claude" ] || { log "no claude found on this Mac: not kept"; exit 1; }
name=$(printf '%s' "${title:-Chat}" | tr -cd '[:alnum:][:space:]._:-' | cut -c1-60)
name="${name:-Chat} (kept on this Mac)"
set -- --bg --resume "$sid" -n "$name" --remote-control "$name"
[ -n "$model" ] && set -- "$@" --model "$model"
[ -n "$effort" ] && set -- "$@" --effort "$effort"
[ -n "$mode" ] && set -- "$@" --permission-mode "$mode"
[ -n "$sources" ] && set -- "$@" --setting-sources "$sources"
for one in $plugins; do [ -d "$one" ] && set -- "$@" --plugin-dir "$one"; done
said=$(cd "$cwd" && env -i HOME="$HOME" USER="${USER:-}" LOGNAME="${LOGNAME:-${USER:-}}" SHELL="${SHELL:-/bin/zsh}" TMPDIR="${TMPDIR:-/tmp}" LANG="${LANG:-en_US.UTF-8}" \
  PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" "$claude" "$@" 2>&1)
copy=$(printf '%s\n' "$said" | sed -n 's/^backgrounded · \([0-9a-f]\{1,\}\) ·.*/\1/p' | head -1)
if [ -z "$copy" ]; then log "the chat could not be started again here: $(printf '%s' "$said" | tr '\n' ' ' | cut -c1-300)"; exit 1; fi
moved=$(now)
printf '{"cutAt":%s,"movedAt":%s,"copy":"%s","count":%s}\n' "$((gone * 1000))" "$((moved * 1000))" "$copy" "$count" > "$dir/$sid.state"
log "the chat goes on here as background session $copy, $((moved - gone))s after its process ended"

# While the copy runs: the app starting the chat again has it stopped at once, so the app finds the chat free; finished work at
# rest a while stops it too. Claude Code keeps the conversation: the app's next start of the chat goes on from it
listed() { "$claude" agents --json 2>/dev/null | /usr/bin/grep -q "\"id\": *\"$copy\""; }
rest=0 looks=0
while :; do
  sleep 1; looks=$((looks + 1))
  if pgrep -f -- "/ccd-cli/.* --resume=$sid" >/dev/null 2>&1; then
    "$claude" stop "$copy" >/dev/null 2>&1
    printf '{"cutAt":%s,"movedAt":%s,"copy":"%s","count":%s,"backAt":%s}\n' "$((gone * 1000))" "$((moved * 1000))" "$copy" "$count" "$(($(now) * 1000))" > "$dir/$sid.state"
    log "the app started the chat again: background session $copy stopped so the app has it"
    exit 0
  fi
  if [ $((looks % 10)) -ne 0 ]; then continue; fi
  if ! listed; then log "background session $copy is gone"; exit 0; fi
  if [ "$(field count "$dir/$sid.json")" = 0 ]; then rest=$((rest + 10)); else rest=0; fi
  if [ "$rest" -ge "$REST" ]; then
    "$claude" stop "$copy" >/dev/null 2>&1
    log "its work is done: background session $copy stopped; the chat opens in the app as before"
    exit 0
  fi
done
