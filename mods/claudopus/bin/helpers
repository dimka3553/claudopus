#!/bin/sh
# Waits for a piece of work's helpers, run by the work itself with Bash: back as soon as the helpers it has running change (one
# ended, or one started), or after three minutes, then prints how each is doing. The mod keeps the file it is given: its first
# line names the helpers running, the rest says how each is doing.
f="$1"
[ -f "$f" ] || { echo "No helper of yours is running."; exit 0; }
first=$(head -n 1 "$f")
[ -n "$first" ] || { tail -n +2 "$f"; exit 0; }
i=0
while [ "$i" -lt 90 ]; do
  [ "$(head -n 1 "$f")" != "$first" ] && break
  sleep 2
  i=$((i + 1))
done
[ "$(head -n 1 "$f")" != "$first" ] && echo "Your helpers changed: one ended (its result comes to you as a message) or one started." || echo "No helper ended in 3 minutes."
tail -n +2 "$f"
