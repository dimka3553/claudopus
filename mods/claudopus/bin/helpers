#!/bin/sh
# Waits for a piece of work's helpers, run by the work itself with Bash: back once the helpers it has running change (one ended,
# one started or one went quiet), which the mod writes at once as a helper ends and within about 20 seconds otherwise, or after 110 seconds, inside Bash's own two-minute limit; then
# prints how each is doing. The file's first line names the helpers running and those gone quiet ("running: <ids> quiet: <ids>"),
# the rest says how each is doing.
f="$1"
[ -f "$f" ] || { echo "No helper of yours is running."; exit 0; }
first=$(head -n 1 "$f")
[ "$first" = "running: " ] && { echo "No helper of yours is running."; tail -n +2 "$f"; exit 0; }
# A message from the person written in while the work waits here makes it come back at once: the work reads it at its next step
replied() { [ -s "$f.reply" ]; }
replied && { echo "A message from the person is waiting for you: it is read the moment this wait ends, which is now. Answer it, then wait again if you still need to."; exit 0; }
changed=''
i=0
while [ "$i" -lt 55 ]; do
  replied && { echo "A message from the person is waiting for you: it is read the moment this wait ends, which is now. Answer it, then wait again if you still need to."; tail -n +2 "$f"; exit 0; }
  now=$(head -n 1 "$f")
  # A file read while it is being written has no first line yet: that is no change
  case "$now" in
    "running: "*) [ "$now" != "$first" ] && { changed=1; break; } ;;
  esac
  # Its row says how it goes: one line every 10 seconds, so a wait on helpers is never taken for a run gone silent
  [ $((i % 5)) -eq 0 ] && echo "progress: $(echo "$now" | sed 's/^running: //; s/ quiet:.*//' | tr ',' '\n' | grep -c .) helpers at work"
  sleep 2
  i=$((i + 1))
done
if [ -n "$changed" ]; then echo "Your helpers changed: one ended (its result comes to you as a message), one started, or one went quiet."; else echo "No helper ended in the last two minutes."; fi
tail -n +2 "$f"
