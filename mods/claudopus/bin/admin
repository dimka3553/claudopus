#!/bin/bash
# Runs one admin (sudo) command on this Mac or on a Mac reached over SSH, with that Mac's password
# from this Mac's keychain. The password is asked once, in a box on this Mac's screen that hides what
# is typed (in the panel, in a chat the app runs on another Mac over ssh), checked, then kept in the keychain. It only ever travels through pipes: never in a command
# line, a file, the output or a log.
#
#   admin here '<command>'         on this Mac
#   admin <ssh host> '<command>'   on that Mac, over SSH
#   admin <mac> --forget           removes the kept password
set -u
mac=${1:-}
command=${2:-}
if [ -z "$mac" ] || [ -z "$command" ] || [ "${mac#-}" != "$mac" ]; then
  echo "usage: admin here|<ssh host> '<command>' | here|<ssh host> --forget" >&2
  exit 2
fi
service=${CLAUDOPUS_ADMIN_SERVICE:-claudopus-admin}

kept() { security find-generic-password -s "$service" -a "$mac" -w 2>/dev/null; }
forget() { security delete-generic-password -s "$service" -a "$mac" >/dev/null 2>&1; }

if [ "$command" = --forget ]; then
  forget && echo "The password for $mac is forgotten." || echo "No password was kept for $mac."
  exit 0
fi

ssh_to() { ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -- "$mac" "$@"; }

# sudo reads the password from stdin (-S), shows no prompt, and ignores any earlier sign-in (-k).
# What it runs gets no stdin of its own, so it can never read the password
sudo_on() {
  if [ "$mac" = here ]; then
    sudo -S -p '' -k "$@"
  else
    ssh_to "sudo -S -p '' -k $(printf '%q ' "$@")"
  fi
}
# 0 when the password is right, 1 when sudo refused it, 5 when the Mac could not be reached
check() {
  sudo_on -v 2>/dev/null
  local status=$?
  [ "$status" = 0 ] && return 0
  [ "$mac" != here ] && [ "$status" = 255 ] && return 5
  return 1
}

# In a chat the app runs on another Mac over ssh, a box on this Mac's screen is one nobody sees: the panel beside the chat asks
# instead. The request names what is needed and never holds a value; what is typed in the panel goes into this Mac's keychain
# under the request's id, and is taken from there and removed at once. 1 when it is cancelled there or nothing comes in 590 s,
# under the longest a Bash call may run
box_ask() {
  local text=$1 boxes=${CLAUDOPUS_BOXES:-$HOME/.claude/claudopus/boxes} id value i status=1
  id=$(/usr/bin/uuidgen | /usr/bin/tr '[:upper:]' '[:lower:]')
  [ -n "$id" ] || return 1
  /bin/mkdir -p "$boxes" || return 1
  /usr/bin/perl -MJSON::PP -e 'print JSON::PP->new->canonical->encode({id => $ARGV[0], text => $ARGV[1], at => time() * 1000}), "\n"' "$id" "$text" >"$boxes/$id.part" &&
    /bin/mv "$boxes/$id.part" "$boxes/$id.json" || return 1
  trap '/bin/rm -f "$boxes/$id.json" "$boxes/$id.told"; /usr/bin/security delete-generic-password -s claudopus-box -a "$id" >/dev/null 2>&1' EXIT
  for ((i = 0; i < 590; i++)); do
    if value=$(/usr/bin/security find-generic-password -s claudopus-box -a "$id" -w 2>/dev/null); then
      printf '%s' "$value"
      unset value
      status=0
      break
    fi
    # Cancel in the panel removes the request
    [ -f "$boxes/$id.json" ] || break
    /bin/sleep 1
  done
  /bin/rm -f "$boxes/$id.json" "$boxes/$id.told"
  /usr/bin/security delete-generic-password -s claudopus-box -a "$id" >/dev/null 2>&1
  trap - EXIT
  return "$status"
}

ask() {
  local label=$mac said=$1
  [ "$mac" = here ] && label="this Mac"
  if [ -n "${CLAUDE_SSH_DAEMON_CHILD:-}" ]; then box_ask "${said}Claudopus needs the admin password of $label to run an admin command for work on this Mac. It is kept in this Mac's keychain, and later admin commands on $label run without asking again until it is forgotten."; return; fi
  osascript \
    -e 'on run argv' \
    -e 'activate' \
    -e 'text returned of (display dialog (item 1 of argv) default answer "" with hidden answer with title "Claudopus" buttons {"Cancel", "OK"} default button "OK" with icon caution giving up after 900)' \
    -e 'end run' \
    "${said}Claudopus needs the admin password of $label to run an admin command. It is kept only in this Mac's keychain, and later admin commands on $label run without asking again until it is forgotten." 2>/dev/null
}

if [ "$mac" != here ] && ! ssh_to true </dev/null 2>/dev/null; then
  echo "$mac could not be reached over SSH." >&2
  exit 5
fi

if ! kept >/dev/null; then
  said=''
  for try in 1 2 3; do
    pw=$(ask "$said") || { echo "No password was typed for $mac." >&2; exit 3; }
    [ -n "$pw" ] || { echo "No password was typed for $mac." >&2; exit 3; }
    printf '%s\n' "$pw" | check
    status=$?
    if [ "$status" = 0 ]; then
      printf '%s\n%s\n' "$pw" "$pw" | security add-generic-password -U -s "$service" -a "$mac" -l "Claudopus admin: $mac" -w >/dev/null 2>&1 ||
        echo "The password for $mac was right but could not be kept in the keychain; it will be asked again next time." >&2
      # The first run uses the password just typed, kept or not
      printf '%s\n' "$pw" | sudo_on /bin/sh -c "exec </dev/null; $command"
      status=$?
      unset pw
      exit "$status"
    fi
    unset pw
    [ "$status" = 5 ] && { echo "$mac could not be reached over SSH." >&2; exit 5; }
    [ "$try" = 3 ] && { echo "The password typed for $mac was refused three times." >&2; exit 4; }
    said='That password was refused. '
  done
fi

# A kept password that sudo refuses is forgotten, so the next run asks again
kept | check
status=$?
if [ "$status" = 5 ]; then
  echo "$mac could not be reached over SSH." >&2
  exit 5
elif [ "$status" != 0 ]; then
  forget
  echo "The kept password for $mac was refused; it is forgotten and will be asked again." >&2
  exit 4
fi
kept | sudo_on /bin/sh -c "exec </dev/null; $command"
