#!/bin/bash -p
# Runs one admin (sudo) command on this Mac or on a Mac reached over SSH, with that Mac's password
# from this Mac's keychain. The password is asked once, in a box at the top of the Claudopus panel (a box on this Mac's screen
# that hides what is typed only where no chat draws a panel), checked, then kept in the keychain. It only ever travels through pipes: never in a command
# line, a file, the output or a log.
#
#   admin here '<command>'         on this Mac
#   admin <ssh host> '<command>'   on that Mac, over SSH
#   admin <mac> --forget           removes the kept password
#
# A command runs only when the person allowed it: the Claudopus hook that holds the Bash call until they press Allow on the work's
# card leaves a grant for this Mac and this exact command, sealed with a key in this Mac's keychain, and this runner takes it once.
# With none it refuses, however it was reached. Only "admin": "never" in config.json, sealed by a press in Config, runs as before.
# -p above: nothing is read from BASH_ENV and no function comes in from the environment
# Handed to a shell as a script, the -p above was not read: it starts again with it, leaving behind whatever BASH_ENV brought in
case $- in *p*) ;; *) exec /bin/bash -p "$0" "$@" ;; esac
set -u
unset PERL5OPT PERL5LIB PERLLIB PERL5DB
# The runner uses only the system's own programs, so nothing earlier on the PATH is handed the password
user_path=$PATH
PATH=/usr/bin:/bin:/usr/sbin:/sbin
mac=${1:-}
command=${2:-}
if [ -z "$mac" ] || [ -z "$command" ] || [ "${mac#-}" != "$mac" ]; then
  echo "usage: admin here|<ssh host> '<command>' | here|<ssh host> --forget" >&2
  exit 2
fi
service=${CLAUDOPUS_ADMIN_SERVICE:-claudopus-admin}

kept() { security find-generic-password -s "$service" -a "$mac" -w 2>/dev/null; }
forget() { security delete-generic-password -s "$service" -a "$mac" >/dev/null 2>&1; }

if [ "$command" = --forget ]; then
  forget && echo "The password for $mac is forgotten." || echo "No password was kept for $mac."
  exit 0
fi

# ---- The gate ----
# Says "never", "granted" or "refused", then where the password comes from ("keep" or "macos"). "never" in config.json counts
# only with the seal Config made; a grant counts when it names this Mac and this command as they reached this runner, is under
# two minutes old and carries the right seal, and it is taken (removed) as it is found
memory=$HOME/.claude/claudopus
gate_key() { security find-generic-password -s claudopus-admin-gate -a seal -w 2>/dev/null; }
gate=$(gate_key | perl -MJSON::PP -MDigest::SHA=hmac_sha256_hex -e '
  my $k = <STDIN>; $k = "" unless defined $k; chomp $k;
  my ($config, $grants, $host, $command) = @ARGV;
  my $read = sub { my $text = do { local $/; open(my $f, "<", $_[0]) or return {}; <$f> }; my $j = eval { decode_json($text) }; ref $j eq "HASH" ? $j : {} };
  my $bytes = sub { my $v = shift; return "" if !defined $v || ref $v; $v = "$v"; utf8::encode($v); $v };
  my $c = $read->($config);
  my $pw = $bytes->($c->{adminPassword}) eq "macos" ? "macos" : "keep";
  if (length $k && $bytes->($c->{admin}) eq "never" && $bytes->($c->{adminSealed}) eq hmac_sha256_hex("mode\nnever", $k)) { print "never $pw"; exit }
  my $ok = 0;
  if (length $k && opendir(my $d, $grants)) {
    for my $name (sort grep { /\.json$/ } readdir $d) {
      my $g = $read->("$grants/$name");
      my ($id, $at) = ($bytes->($g->{id}), $bytes->($g->{at}));
      next unless $at =~ /^\d+$/ && abs(time() * 1000 - $at) <= 120_000;
      next unless $bytes->($g->{host}) eq $host && $bytes->($g->{command}) eq $command;
      next unless $bytes->($g->{seal}) eq hmac_sha256_hex("grant\n$id\n$at\n$host\n$command", $k);
      next unless rename("$grants/$name", "$grants/$name.$$");
      unlink "$grants/$name.$$";
      $ok = 1;
      last;
    }
  }
  print(($ok ? "granted" : "refused"), " $pw");
' "$memory/config.json" "$memory/admin-grants" "$mac" "$command")
case $gate in
never\ * | granted\ *) ;;
*)
  echo "Refused: this admin command did not run, because it was not allowed on its card in the Claudopus panel. Run it as one Bash call of its own, written out in full with nothing for the shell to fill in: $0 here|<ssh host> '<command>'. The card then shows it and asks." >&2
  exit 6
  ;;
esac

ssh_to() { ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -- "$mac" "$@"; }

# sudo reads the password from stdin (-S), shows no prompt, and ignores any earlier sign-in (-k).
# What it runs gets no stdin of its own, so it can never read the password
sudo_on() {
  if [ "$mac" = here ]; then
    sudo -S -p '' -k "$@"
  else
    ssh_to "sudo -S -p '' -k $(printf '%q ' "$@")"
  fi
}
# 0 when the password is right, 1 when sudo refused it, 5 when the Mac could not be reached
check() {
  sudo_on -v 2>/dev/null
  local status=$?
  [ "$status" = 0 ] && return 0
  [ "$mac" != here ] && [ "$status" = 255 ] && return 5
  return 1
}

# The Claudopus panel beside the chat asks, in every chat. The request names what is needed in fields (kind admin or secret, the
# Mac as host or the key as name, and why it asks again), which the panel words itself, and the chat that asks; it holds no text that
# is shown and never a value; what is typed in the panel goes into this Mac's keychain under the request's id, and is taken from there and
# removed at once. 1 when it is cancelled there or nothing comes in 590 s, under the longest a Bash call may run; 2 when no chat
# with a panel takes the request in its first 15 s (the .told mark), as in a -p run with no chat open on this Mac
box_ask() {
  local boxes=${CLAUDOPUS_BOXES:-$HOME/.claude/claudopus/boxes} id value i status=1 taken=${CLAUDOPUS_BOX_TAKEN:-15}
  id=$(/usr/bin/uuidgen | /usr/bin/tr '[:upper:]' '[:lower:]')
  [ -n "$id" ] || return 1
  /bin/mkdir -p "$boxes" || return 1
  # $@: the request's fields as name value pairs; an empty value is left out
  /usr/bin/perl -MJSON::PP -e 'my %r = (id => shift, chat => shift, at => time() * 1000); while (@ARGV) { my ($k, $v) = splice @ARGV, 0, 2; $r{$k} = $v if length $v } print JSON::PP->new->canonical->encode(\%r), "\n"' "$id" "${CLAUDE_CODE_SESSION_ID:-}" "$@" >"$boxes/$id.part" &&
    /bin/mv "$boxes/$id.part" "$boxes/$id.json" || return 1
  trap '/bin/rm -f "$boxes/$id.json" "$boxes/$id.told"; /usr/bin/security delete-generic-password -s claudopus-box -a "$id" >/dev/null 2>&1' EXIT
  for ((i = 0; i < 590; i++)); do
    if value=$(/usr/bin/security find-generic-password -s claudopus-box -a "$id" -w 2>/dev/null); then
      printf '%s' "$value"
      unset value
      status=0
      break
    fi
    # Cancel in the panel removes the request
    [ -f "$boxes/$id.json" ] || break
    # No chat took it: no panel draws on this Mac
    [ "$i" -ge "$taken" ] && [ ! -f "$boxes/$id.told" ] && { status=2; break; }
    /bin/sleep 1
  done
  /bin/rm -f "$boxes/$id.json" "$boxes/$id.told"
  /usr/bin/security delete-generic-password -s claudopus-box -a "$id" >/dev/null 2>&1
  trap - EXIT
  return "$status"
}

# Reached over ssh, nobody sees this Mac's screen
afar() { [ -n "${CLAUDE_SSH_DAEMON_CHILD:-}${SSH_CONNECTION:-}${SSH_TTY:-}" ]; }

# $1: why it asks again, empty or refused
ask() {
  local label=$mac again=$1 said='' text status
  [ "$mac" = here ] && label="this Mac"
  [ "$again" = refused ] && said='That password was refused. '
  text="${said}Claudopus needs the admin password of $label to run an admin command. It is kept only in this Mac's keychain, and later admin commands on $label run without asking again until it is forgotten."
  box_ask kind admin host "$mac" again "$again"
  status=$?
  [ "$status" = 2 ] || return "$status"
  # Only where no chat draws a panel on this Mac: a box on its screen, when someone can see it
  if afar; then echo "No Claudopus panel on this Mac took the request: open the panel with /claudopus in a chat here and run it again." >&2; return 1; fi
  osascript \
    -e 'on run argv' \
    -e 'activate' \
    -e 'text returned of (display dialog (item 1 of argv) default answer "" with hidden answer with title "Claudopus" buttons {"Cancel", "OK"} default button "OK" with icon caution giving up after 900)' \
    -e 'end run' \
    "$text" 2>/dev/null
}

# On this Mac the command keeps the PATH it was given; over SSH, that Mac's own
with_path=''
[ "$mac" = here ] && with_path="PATH=$(printf '%q' "$user_path"); export PATH; "

# "Let macOS ask, keep nothing": macOS asks for the password in its own box on this Mac's screen, each time, and runs the command;
# no password is kept, typed into the panel or read here. Only on this Mac, and only where its screen is seen
if [ "${gate#* }" = macos ]; then
  if [ "$mac" != here ]; then
    echo "Admin commands are set to let macOS ask for the password and keep none, which works only on this Mac, not on $mac over SSH." >&2
    exit 7
  fi
  if afar; then
    echo "Admin commands are set to let macOS ask for the password and keep none. macOS asks on this Mac's own screen, which nobody sees from a chat reached over SSH, so nothing ran. It runs from a chat at this Mac, or once Config's Admin password is set back to the keychain." >&2
    exit 7
  fi
  out=$(mktemp -d "${TMPDIR:-/tmp}/claudopus-admin.XXXXXX") || exit 1
  trap 'rm -rf "$out"' EXIT
  # What it prints comes back through files in a folder of this run's own. Root makes each one new (set -C) and never writes
  # through a link someone else put there
  script="set -C; ( set +C; exec </dev/null; ${with_path}$command ) >$(printf '%q' "$out/out") 2>$(printf '%q' "$out/err"); echo \$? >$(printf '%q' "$out/status")"
  if ! osascript -e 'on run argv' -e 'do shell script (item 1 of argv) with administrator privileges' -e 'end run' "$script" >/dev/null 2>"$out/osa"; then
    if grep -q -e '-128' "$out/osa"; then
      echo "The macOS password box was cancelled, so the command did not run." >&2
      exit 3
    fi
    echo "macOS could not ask for the admin password, so the command did not run: $(cat "$out/osa")" >&2
    exit 1
  fi
  cat "$out/out"
  cat "$out/err" >&2
  status=$(cat "$out/status" 2>/dev/null)
  exit "${status:-1}"
fi

if [ "$mac" != here ] && ! ssh_to true </dev/null 2>/dev/null; then
  echo "$mac could not be reached over SSH." >&2
  exit 5
fi

if ! kept >/dev/null; then
  again=''
  for try in 1 2 3; do
    pw=$(ask "$again") || { echo "No password was typed for $mac." >&2; exit 3; }
    [ -n "$pw" ] || { echo "No password was typed for $mac." >&2; exit 3; }
    printf '%s\n' "$pw" | check
    status=$?
    if [ "$status" = 0 ]; then
      printf '%s\n%s\n' "$pw" "$pw" | security add-generic-password -U -s "$service" -a "$mac" -l "Claudopus admin: $mac" -w >/dev/null 2>&1 ||
        echo "The password for $mac was right but could not be kept in the keychain; it will be asked again next time." >&2
      # The first run uses the password just typed, kept or not
      printf '%s\n' "$pw" | sudo_on /bin/sh -c "exec </dev/null; ${with_path}$command"
      status=$?
      unset pw
      exit "$status"
    fi
    unset pw
    [ "$status" = 5 ] && { echo "$mac could not be reached over SSH." >&2; exit 5; }
    [ "$try" = 3 ] && { echo "The password typed for $mac was refused three times." >&2; exit 4; }
    again=refused
  done
fi

# A kept password that sudo refuses is forgotten, so the next run asks again
kept | check
status=$?
if [ "$status" = 5 ]; then
  echo "$mac could not be reached over SSH." >&2
  exit 5
elif [ "$status" != 0 ]; then
  forget
  echo "The kept password for $mac was refused; it is forgotten and will be asked again." >&2
  exit 4
fi
kept | sudo_on /bin/sh -c "exec </dev/null; ${with_path}$command"
