#!/bin/bash -p
# Runs one admin (sudo) command on this Mac or on a Mac reached over SSH. No admin password is ever kept: each command asks for it.
# On this Mac, with someone at its screen, macOS asks in its own box, which names the command, and runs it; this runner never sees
# the password. Over SSH, on Linux, or in a chat reached from another device, it is asked in a box at the top of the Claudopus panel
# (a box on this Mac's screen that hides what is typed only where no chat draws a panel), sealed there to a key this one run made and
# holds only in its memory, checked, used for this command and dropped. It only ever travels through pipes: never in a command line,
# a file, the output or a log.
#
#   admin here '<command>'         on this Mac
#   admin <ssh host> '<command>'   on that Mac, over SSH
#   admin <mac> --forget           removes a password an earlier version kept
#
# A command runs only when the person allowed it: the Claudopus hook that holds the Bash call until they press Allow on the work's
# card leaves a grant for this Mac and this exact command, sealed with a key in this Mac's keychain, and this runner takes it once.
# With none it refuses, however it was reached. Only "admin": "never" in config.json, sealed by a press in Config, runs as before.
# -p above: nothing is read from BASH_ENV and no function comes in from the environment
# Handed to a shell as a script, the -p above was not read: it starts again with it, leaving behind whatever BASH_ENV brought in
case $- in *p*) ;; *) exec /bin/bash -p "$0" "$@" ;; esac
set -u
unset PERL5OPT PERL5LIB PERLLIB PERL5DB
# The runner uses only the system's own programs, so nothing earlier on the PATH is handed the password (on Windows Git's own,
# whose openssl is in /mingw64/bin)
PATH=/usr/bin:/bin:/usr/sbin:/sbin
case $(uname -s) in MINGW* | MSYS* | CYGWIN*) windows=1 PATH=$PATH:/mingw64/bin ;; *) windows= ;; esac
# The home folder is the one the user database names for this user, never $HOME, which whoever runs this can set to a folder of
# their own (with a key, a sealed setting and grants made there); on Windows the profile Windows names for this user, as bin/keyring
# finds it
own_home=$(/usr/bin/perl -e 'print((getpwuid($<))[7] // "")' 2>/dev/null); case $(uname -s) in MINGW* | MSYS* | CYGWIN*) p=$(cygpath -F 40 2>/dev/null); own_home=$(cygpath -u "${p:-${USERPROFILE:-}}" 2>/dev/null) ;; esac
[ -n "$own_home" ] || own_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
[ -n "$own_home" ] && [ -d "$own_home" ] || { echo "admin: this user has no home folder" >&2; exit 1; }
HOME=$own_home
export HOME
mac=${1:-}
command=${2:-}
if [ -z "$mac" ] || [ -z "$command" ] || [ "${mac#-}" != "$mac" ]; then
  echo "usage: admin here|<ssh host> '<command>' | here|<ssh host> --forget" >&2
  exit 2
fi
# Where earlier versions kept admin passwords: fixed, so nothing the caller sets points the runner at another store
service=claudopus-admin
# This Mac's keychain, or on Linux a folder only this user reads: bin/keyring beside this runner
keyring=$(cd -P "$(dirname "$0")" && pwd)/keyring
# What this computer is called in what is said: a Mac, this PC on Windows, or on Linux this machine
if [ "$(uname -s)" = Darwin ]; then machine='this Mac'; elif [ -n "$windows" ]; then machine='this PC'; else machine='this machine'; fi

forget() { "$keyring" delete "$service" "$mac" >/dev/null 2>&1; }

if [ "$command" = --forget ]; then
  forget && echo "The password for $mac is forgotten." || echo "No password was kept for $mac."
  exit 0
fi

# Windows has no sudo, and no box of its own that asks for an admin password: a command for this PC is the person's to run
if [ -n "$windows" ] && [ "$mac" = here ]; then
  echo "Refused: this admin command did not run. Windows has no admin runner: run it yourself in a terminal opened as administrator. An admin command for a Mac or Linux machine reached over SSH runs as before." >&2
  exit 6
fi

# ---- The gate ----
# Says "never", "granted" or "refused". "never" in config.json counts only with the seal Config made; a grant counts when it names
# this Mac and this command as they reached this runner, is under two minutes old and carries the right seal, and it is taken
# (removed) as it is found. The seal spares the person the card's press, never the password: whatever gets past here, nothing runs
# as admin until the person types the password for this very command (below), so a seal made by anything else runs nothing by itself
memory=$HOME/.claude/claudopus
gate_key() { "$keyring" get claudopus-admin-gate seal 2>/dev/null; }
gate=$(gate_key | perl -MJSON::PP -MDigest::SHA=hmac_sha256_hex -e '
  my $k = <STDIN>; $k = "" unless defined $k; chomp $k;
  my ($config, $grants, $host, $command) = @ARGV;
  my $read = sub { my $text = do { local $/; open(my $f, "<", $_[0]) or return {}; <$f> }; my $j = eval { decode_json($text) }; ref $j eq "HASH" ? $j : {} };
  my $bytes = sub { my $v = shift; return "" if !defined $v || ref $v; $v = "$v"; utf8::encode($v); $v };
  my $c = $read->($config);
  if (length $k && $bytes->($c->{admin}) eq "never" && $bytes->($c->{adminSealed}) eq hmac_sha256_hex("mode\nnever", $k)) { print "never"; exit }
  my $ok = 0;
  if (length $k && opendir(my $d, $grants)) {
    for my $name (sort grep { /\.json$/ } readdir $d) {
      my $g = $read->("$grants/$name");
      my ($id, $at) = ($bytes->($g->{id}), $bytes->($g->{at}));
      next unless $at =~ /^\d+$/ && abs(time() * 1000 - $at) <= 120_000;
      next unless $bytes->($g->{host}) eq $host && $bytes->($g->{command}) eq $command;
      next unless $bytes->($g->{seal}) eq hmac_sha256_hex("grant\n$id\n$at\n$host\n$command", $k);
      next unless rename("$grants/$name", "$grants/$name.$$");
      unlink "$grants/$name.$$";
      $ok = 1;
      last;
    }
  }
  print($ok ? "granted" : "refused");
' "$memory/config.json" "$memory/admin-grants" "$mac" "$command")
case $gate in
never | granted) ;;
*)
  echo "Refused: this admin command did not run, because it was not allowed on its card in the Claudopus panel. Run it as one Bash call of its own, written out in full with nothing for the shell to fill in: $0 here|<ssh host> '<command>'. The card then shows it and asks." >&2
  exit 6
  ;;
esac

ssh_to() { ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -- "$mac" "$@"; }

# sudo reads the password from stdin (-S), shows no prompt, and ignores any earlier sign-in (-k).
# What it runs gets no stdin of its own, so it can never read the password
sudo_on() {
  if [ "$mac" = here ]; then
    sudo -S -p '' -k "$@"
  else
    ssh_to "sudo -S -p '' -k $(printf '%q ' "$@")"
  fi
}
# 0 when the password is right, 1 when sudo refused it, 5 when the Mac could not be reached
check() {
  sudo_on -v 2>/dev/null
  local status=$?
  [ "$status" = 0 ] && return 0
  [ "$mac" != here ] && [ "$status" = 255 ] && return 5
  return 1
}

# The Claudopus panel beside the chat asks, in every chat. The request names what is needed in fields (kind admin or secret, the
# Mac as host or the key as name, and why it asks again), which the panel words itself, and the chat that asks; it holds no text that
# is shown and never a value. It carries the public half of a key made for this one request, whose private half stays in this
# runner's memory (a shell variable, handed to openssl on a pipe): the panel seals what is typed to it before it goes into this Mac's
# keychain under the request's id, so what sits there for a moment is of no use to anything that reads it. It is taken from there,
# removed at once and opened here. 1 when it is cancelled there or nothing comes in 590 s, under the longest a Bash call may run; 2 when
# no chat with a panel takes the request in its first 15 s (the .told mark), as in a -p run with no chat open on this Mac
box_ask() {
  local boxes=${CLAUDOPUS_BOXES:-$HOME/.claude/claudopus/boxes} id value i status=1 taken=${CLAUDOPUS_BOX_TAKEN:-15} private public
  # uuidgen, or Linux's own where it is not installed, else one made of random bytes (Git's bash on Windows has neither)
  id=$({ /usr/bin/uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n' | sed -E 's/^(.{8})(.{4})(.{4})(.{4})(.{12})$/\1-\2-\3-\4-\5\n/'; } | /usr/bin/tr '[:upper:]' '[:lower:]')
  [ -n "$id" ] || return 1
  private=$(openssl genrsa 2048 2>/dev/null) && [ -n "$private" ] || return 1
  public=$(printf '%s\n' "$private" | openssl rsa -pubout -outform DER 2>/dev/null | openssl base64 -A) && [ -n "$public" ] || return 1
  /bin/mkdir -p "$boxes" || return 1
  # $@: the request's fields as name value pairs; an empty value is left out
  /usr/bin/perl -MJSON::PP -e 'my %r = (id => shift, chat => shift, key => shift, at => time() * 1000); while (@ARGV) { my ($k, $v) = splice @ARGV, 0, 2; $r{$k} = $v if length $v } print JSON::PP->new->canonical->encode(\%r), "\n"' "$id" "${CLAUDE_CODE_SESSION_ID:-}" "$public" "$@" >"$boxes/$id.part" &&
    /bin/mv "$boxes/$id.part" "$boxes/$id.json" || return 1
  trap '/bin/rm -f "$boxes/$id.json" "$boxes/$id.told"; "$keyring" delete claudopus-box "$id" >/dev/null 2>&1' EXIT
  for ((i = 0; i < 590; i++)); do
    if value=$("$keyring" get claudopus-box "$id" 2>/dev/null); then
      "$keyring" delete claudopus-box "$id" >/dev/null 2>&1
      # Opened with the private half on a pipe of its own: it is never in a file or a command line. On Windows Git's openssl is a
      # Windows program, which cannot open the shell's pipe by its name: there the private half is a file for that moment, in a
      # folder of this run's own under the person's profile, which only they can read, removed as soon as it is opened
      if [ -n "$windows" ]; then
        open_with=$(mktemp -d "$HOME/.claudopus-admin.XXXXXX") && (umask 077; printf '%s\n' "$private" >"$open_with/key") &&
          printf '%s' "$value" | openssl base64 -d -A 2>/dev/null | openssl pkeyutl -decrypt -inkey "$open_with/key" -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 2>/dev/null && status=0
        [ -n "${open_with:-}" ] && /bin/rm -rf "$open_with"
      else
        printf '%s' "$value" | openssl base64 -d -A 2>/dev/null | openssl pkeyutl -decrypt -inkey /dev/fd/3 -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 3< <(printf '%s\n' "$private") 2>/dev/null && status=0
      fi
      unset value
      break
    fi
    # Cancel in the panel removes the request
    [ -f "$boxes/$id.json" ] || break
    # No chat took it: no panel draws on this Mac
    [ "$i" -ge "$taken" ] && [ ! -f "$boxes/$id.told" ] && { status=2; break; }
    /bin/sleep 1
  done
  /bin/rm -f "$boxes/$id.json" "$boxes/$id.told"
  "$keyring" delete claudopus-box "$id" >/dev/null 2>&1
  unset private
  trap - EXIT
  return "$status"
}

# Reached over ssh, nobody sees this Mac's screen
afar() { [ -n "${CLAUDE_SSH_DAEMON_CHILD:-}${SSH_CONNECTION:-}${SSH_TTY:-}" ]; }

# $1: why it asks again, empty or refused
ask() {
  local label=$mac again=$1 said='' text status
  [ "$mac" = here ] && label=$machine
  [ "$again" = refused ] && said='That password was refused. '
  text="${said}Claudopus needs the admin password of $label to run this admin command: $(printf '%s' "$command" | tr '\n' ' ' | cut -c1-300). Nothing is kept: the next admin command asks again."
  box_ask kind admin host "$mac" again "$again"
  status=$?
  [ "$status" = 2 ] || return "$status"
  # Only where no chat draws a panel on this Mac: a box on its screen, when someone can see it
  # Linux has no box of its own to ask on the screen: there the panel is the one place it is asked
  if afar || [ "$machine" != 'this Mac' ]; then echo "No Claudopus panel on $machine took the request: open the panel with /claudopus in a chat here and run it again." >&2; return 1; fi
  osascript \
    -e 'on run argv' \
    -e 'activate' \
    -e 'text returned of (display dialog (item 1 of argv) default answer "" with hidden answer with title "Claudopus" buttons {"Cancel", "OK"} default button "OK" with icon caution giving up after 900)' \
    -e 'end run' \
    "$text" 2>/dev/null
}

# On this Mac the command runs as root with the system's own PATH, never the caller's: a program it names by its bare name is the
# system's, not one a caller put earlier on its PATH. A program kept anywhere else is named by its full path. Over SSH, that Mac's own
root_path=/usr/bin:/bin:/usr/sbin:/sbin
[ "$machine" = 'this Mac' ] || root_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
with_path=''
[ "$mac" = here ] && with_path="PATH=$root_path; export PATH; "
# For its test only: past the gate, it prints the shell line root would be handed and runs nothing, asking for no password
if [ -n "${CLAUDOPUS_ADMIN_SHOW:-}" ]; then printf '%s\n' "${with_path}$command"; exit 0; fi

# A password an earlier version kept for this Mac is forgotten, never used: every command asks
forget

# On this Mac, with someone at its screen: macOS asks for the password in its own box, which names the command, and runs it. The
# password goes to macOS alone, never to this runner, the panel or a file
if [ "$mac" = here ] && [ "$machine" = 'this Mac' ] && ! afar; then
  out=$(mktemp -d "${TMPDIR:-/tmp}/claudopus-admin.XXXXXX") || exit 1
  trap 'rm -rf "$out"' EXIT
  # What it prints comes back through files in a folder of this run's own. Root makes each one new (set -C) and never writes
  # through a link someone else put there
  script="set -C; ( set +C; exec </dev/null; ${with_path}$command ) >$(printf '%q' "$out/out") 2>$(printf '%q' "$out/err"); echo \$? >$(printf '%q' "$out/status")"
  prompt="Claudopus wants to run this admin command on this Mac: $(printf '%s' "$command" | tr '\n' ' ' | cut -c1-300)"
  if ! osascript -e 'on run argv' -e 'do shell script (item 1 of argv) with prompt (item 2 of argv) with administrator privileges' -e 'end run' "$script" "$prompt" >/dev/null 2>"$out/osa"; then
    if grep -q -e '-128' "$out/osa"; then
      echo "The macOS password box was cancelled, so the command did not run." >&2
      exit 3
    fi
    echo "macOS could not ask for the admin password, so the command did not run: $(cat "$out/osa")" >&2
    exit 1
  fi
  cat "$out/out"
  cat "$out/err" >&2
  status=$(cat "$out/status" 2>/dev/null)
  exit "${status:-1}"
fi

if [ "$mac" != here ] && ! ssh_to true </dev/null 2>/dev/null; then
  echo "$mac could not be reached over SSH." >&2
  exit 5
fi

# Elsewhere the panel's box asks, for this command alone: the password is checked, used once and dropped, never kept
again=''
for try in 1 2 3; do
  pw=$(ask "$again") || { echo "No password was typed for $mac." >&2; exit 3; }
  [ -n "$pw" ] || { echo "No password was typed for $mac." >&2; exit 3; }
  printf '%s\n' "$pw" | check
  status=$?
  if [ "$status" = 0 ]; then
    printf '%s\n' "$pw" | sudo_on /bin/sh -c "exec </dev/null; ${with_path}$command"
    status=$?
    unset pw
    exit "$status"
  fi
  unset pw
  [ "$status" = 5 ] && { echo "$mac could not be reached over SSH." >&2; exit 5; }
  [ "$try" = 3 ] && { echo "The password typed for $mac was refused three times." >&2; exit 4; }
  again=refused
done
