#!/bin/sh
# Runs a command Claude Code refused a task, on the person's own press of Run it in the Claudopus panel, as a command they type in
# their terminal would run. Claudopus starts it only from that press; nothing here decides what runs.
#   run-it start <command> <output file> <folder>   starts it detached, in a process group of its own, and prints that group's
#                                                   number; what it prints goes to the output file, whose last line is then
#                                                   "claudopus-exit <status>" ("claudopus-exit <status> stopped" when stopped)
#   run-it alive <group> <output file>              exits 0 while the run started for that output file still runs
#   run-it stop <group> <output file>               stops that run's whole process group, nothing more of its command line
#                                                   starting, and says so in its output
# A group number is acted on only while its first process is the run started for that output file, so a number reused by another
# process of the person's is never stopped
here=$(cd "$(dirname "$0")" && pwd)
self="$here/$(basename "$0")"
isRun() { ps -o args= -p "$1" 2>/dev/null | grep -qF -- "$2"; }
case "$1" in
start)
  [ $# -eq 4 ] || exit 2
  : >> "$3" || exit 1
  # Linux makes the group with setsid; macOS has none, and its sh gives a job started with job control on a group of its own
  if command -v setsid > /dev/null 2>&1; then
    setsid "$self" _run "$2" "$3" "$4" < /dev/null > /dev/null 2>&1 &
  else
    set -m
    "$self" _run "$2" "$3" "$4" < /dev/null > /dev/null 2>&1 &
  fi
  echo $!
  ;;
_run)
  trap '' HUP
  # Claude Code's own marks out of its environment, so a Claude Code or a tool it starts runs as one the person starts; the
  # person's own start files then set what they set themselves
  for v in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | grep -E '^(CLAUDECODE|CLAUDE_[A-Za-z0-9_]*|ANTHROPIC_[A-Za-z0-9_]*|MCP_[A-Za-z0-9_]*|GIT_EDITOR)$'); do unset "$v"; done
  S=${SHELL:-/bin/sh}
  [ -x "$S" ] || S=/bin/sh
  if cd "$4" 2>> "$3"; then
    # The person's shell with their start files: zsh reads .zprofile and .zshrc as their terminal's does; another shell its login files
    case "$S" in
    *zsh) "$S" -i -l -c "$2" < /dev/null >> "$3" 2>&1 ;;
    *) "$S" -l -c "$2" < /dev/null >> "$3" 2>&1 ;;
    esac
    echo "claudopus-exit $?" >> "$3"
  else
    echo "claudopus-exit 1" >> "$3"
  fi
  ;;
alive)
  isRun "$2" "$3"
  ;;
stop)
  isRun "$2" "$3" || exit 0
  # Ended on its own meanwhile: its own end stands
  tail -n 1 "$3" 2> /dev/null | grep -q '^claudopus-exit' && exit 0
  # The run and the shell it started first, so nothing more of the command line starts (an interactive zsh ignores TERM and would
  # go on to the next command); then what is running now is asked to end, and made to. (A group's signal is given with -s: Linux's
  # sh, dash, takes the -- of "kill -TERM -- -<group>" for a number, fails, and would leave the whole group running)
  kill -KILL $(pgrep -P "$2" 2> /dev/null) "$2" 2> /dev/null
  kill -s TERM -- "-$2" 2> /dev/null
  n=0
  while [ $n -lt 30 ] && kill -s 0 -- "-$2" 2> /dev/null; do sleep 0.1; n=$((n + 1)); done
  kill -s KILL -- "-$2" 2> /dev/null
  echo "claudopus-exit 143 stopped" >> "$3"
  ;;
*)
  exit 2
  ;;
esac
