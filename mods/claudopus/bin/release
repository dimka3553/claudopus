#!/bin/bash -p
# release [-m "title"] [branch]: the one way work reaches a repo's main branch, so two pieces of work never release at once.
# Run it from the work's own worktree, its work committed on its own branch. On this Mac releases of a repo take their place in
# a line and are checked side by side, each on top of the one ahead, and land in turn; across Macs, git's refusal of a push that
# is not a fast-forward makes it take main again. It takes main as it is now (with the releases ahead of it), merges the branch,
# numbers the version, rebuilds what the build makes, refuses files the build left that the repo does not track, runs the repo's
# checks on the result, pushes main and the version's tag.
#   release --status   says who is releasing in this repo now, and since when
# Exit: 0 released; 2 main and the branch changed the same lines (merge main into the branch, resolve, commit, run again);
#       3 the build or the checks failed (fix on the branch, run again), or GitHub's checks (GITHUB_CHECKS) failed, were missing
#       or did not end in time (it names which), or, with GITHUB_RELEASE, its notes could not be made
#       or gh cannot make the release (not installed, not signed in, no write access to the repo: fix that, run again); 4 main was pushed but its tag or its GitHub release was
#       not (it says the one command that finishes it); 1 anything else. Nothing is pushed to main unless it exits 0 or 4 (with
#       GITHUB_CHECKS the release's commit goes to a refs/release-check/ ref for GitHub to check, removed again as it ends).
# Settings, all optional, in the repo's committed `.release` (bash): MAIN (main), REMOTE (origin), NAME (put before the version
# in the title), VERSION_FILE (a JSON file with "version": "x.y.z", or a file holding only x.y.z), DERIVED (files the build
# makes, never merged), BUILD, CHECK (commands run in the release's own checkout), AFTER (run in the work's worktree once
# pushed), GITHUB_RELEASE (a command, run in the release's checkout with the version in RELEASE_VERSION, that prints the
# notes of the version's GitHub release: with it every release with a version is made a GitHub release marked latest, and gh
# must be signed in, which is checked before anything is pushed), GITHUB_CHECKS (names of GitHub's jobs, by commas, that must pass
# on the very commit main is to become, run by main's own CHECKS_WORKFLOW (check.yml), which takes a `sha` input to check out and
# is named "Release check <sha>": main moves only once every job of that run passed; red, a named one missing, or still running
# after 40 minutes, and nothing reaches main; CHECK runs here while GitHub checks, and both must pass). `release.local` in the repo's git folder, never committed, can set the same for this Mac only, such as AFTER.
# The settings are read in a shell of their own and only as values, main's own committed `.release` (never the branch's) and this Mac's
# release.local, so nothing a branch writes there runs here, before the lock or after it.
# Inside Claude Code it releases only what the person allowed with a press on the work's card in the Claudopus panel: the hook that
# holds the call leaves a grant naming this worktree and this branch, sealed as bin/admin's are, which this runner takes once. Run by
# hand outside Claude Code at a terminal, it asks there instead. Exit 6 when neither said yes: nothing is done.
set -uo pipefail
# Nothing of the caller's environment decides what runs here or in what it starts (git, perl, gh, the build and checks): -p above
# reads no BASH_ENV and takes no function from it, and a run with anything beyond the few it needs starts itself again with only
# those, so no PERL5OPT, XDG_CONFIG_HOME, GIT_ or BASH_FUNC_ setting reaches git, perl or a child shell
KEPT_ENV="HOME USER LOGNAME LANG LC_ALL LC_CTYPE TERM TMPDIR SSH_AUTH_SOCK PATH CLAUDECODE CLAUDE_CODE_EXECPATH GH_TOKEN GITHUB_TOKEN RELEASE_LOCKS RELEASE_BARRIER RELEASE_BEAT RELEASE_CHECK_WAIT RELEASE_CHECK_EVERY PWD OLDPWD SHLVL _"
extra=
for v in $(compgen -e); do case " $KEPT_ENV " in *" $v "*) ;; *) extra=1 ;; esac; done
[ -z "$(/usr/bin/env | /usr/bin/sed -n '/^BASH_FUNC_/p')" ] || extra=1
if [ -n "$extra" ]; then
  kept=()
  for v in $KEPT_ENV; do [ "$v" = _ ] || [ -z "${!v+x}" ] || kept+=("$v=${!v}"); done
  exec /usr/bin/env -i "${kept[@]}" /bin/bash -p "$0" "$@"
fi
# The system's own tools come before anything the caller's PATH adds
PATH=/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}
export PATH
unset CDPATH
say() { echo "release: $*" >&2; }
die() { say "$1"; exit "${2:-1}"; }
# The home folder is the one the user database names for this user, never $HOME, which whoever runs this can set to a folder of
# their own (with a key and grants made there)
own_home=$(/usr/bin/perl -e 'print((getpwuid($<))[7] // "")' 2>/dev/null)
[ -n "$own_home" ] || own_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
[ -n "$own_home" ] && [ -d "$own_home" ] || die "this user has no home folder"
HOME=$own_home
export HOME

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repo"
common=$(cd "$top" && cd "$(git rev-parse --git-common-dir)" && pwd)
MAIN= REMOTE=origin NAME= VERSION_FILE= DERIVED= BUILD= CHECK= AFTER= GITHUB_RELEASE= GITHUB_CHECKS= CHECKS_WORKFLOW=
# A settings file's values, read in a bash of its own started afresh from the system's own path (no BASH_ENV, no function brought in):
# what else it defines, a function or another variable, never reaches this shell. $1 the file (read from its own folder), $2 the names
settings_of() {
  [ -f "$1" ] || return 0
  local said
  said=$(cd "$(dirname "$1")" && env -u BASH_ENV -u ENV /bin/bash --noprofile --norc -c '. "$1" >/dev/null 2>&1 </dev/null; shift; for v in "$@"; do [ -n "${!v+x}" ] && printf "%s=%q\n" "$v" "${!v}"; done; exit 0' bash "$1" $2 2>/dev/null) || return 0
  eval "$said"
}
SETTINGS="MAIN REMOTE NAME VERSION_FILE DERIVED BUILD CHECK AFTER GITHUB_RELEASE GITHUB_CHECKS CHECKS_WORKFLOW"
settings_of "$common/release.local" "$SETTINGS"
url=$(git -C "$top" remote get-url "$REMOTE" 2>/dev/null) || die "no remote $REMOTE"
# With no MAIN set, main is the remote's own default branch (main, master or another), else main
if [ -z "$MAIN" ]; then
  MAIN=$(git -C "$top" symbolic-ref --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null | sed "s#^$REMOTE/##")
  [ -n "$MAIN" ] || MAIN=$(git -C "$top" ls-remote --symref "$REMOTE" HEAD 2>/dev/null | sed -n 's#^ref: refs/heads/\([^[:space:]]*\).*#\1#p')
  [ -n "$MAIN" ] || MAIN=main
fi
locks=${RELEASE_LOCKS:-$HOME/.claude/claudopus/locks}
lock="$locks/$(printf %s "$url" | shasum | cut -c1-12).lock"

if [ "${1:-}" = --status ]; then
  n=0
  for e in $(ls "$lock.line" 2>/dev/null | grep -E '^[0-9]{8}$' | sort); do
    p=$(sed -n 's/^pid=//p' "$lock.line/$e" | head -1); at=$(sed -n 's/^started=//p' "$lock.line/$e" | head -1)
    [ -n "$p" ] && [ "$(ps -o lstart= -p "$p" 2>/dev/null | tr -s ' ')" = "$at" ] || continue
    echo "releasing now: $(sed -n 's/^branch=//p' "$lock.line/$e" | head -1), at $(sed -n 's/^stage=//p' "$lock.line/$e" | head -1)"; n=$((n + 1))
  done
  [ -d "$lock" ] && kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null && { echo "taking its place in line: $(cat "$lock/who" 2>/dev/null)"; n=$((n + 1)); }
  [ $n -gt 0 ] || echo "no release running for $(basename "$top")"
  exit 0
fi
title=
if [ "${1:-}" = -m ]; then title=${2:-}; shift 2 || die "-m needs a title"; fi
branch=${1:-$(git -C "$top" rev-parse --abbrev-ref HEAD)}
[ "$branch" = HEAD ] && die "you are on no branch: commit your work on a branch of your own"
[ "$branch" = "$MAIN" ] && die "release a branch of your own, never $MAIN itself"
git -C "$top" rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no branch $branch"
[ -z "$(git -C "$top" status --porcelain --untracked-files=no)" ] || die "uncommitted changes in $top: commit them to $branch or drop them first"

# The person's press: a grant for this worktree and this branch, under two minutes old, sealed with the admin gate's key, taken once
here_bin=$(cd -P "$(dirname "$0")" && pwd)
granted=$("$here_bin/keyring" get claudopus-admin-gate seal 2>/dev/null | /usr/bin/perl -MJSON::PP -MDigest::SHA=hmac_sha256_hex -e '
  my $k = <STDIN>; $k = "" unless defined $k; chomp $k;
  my ($grants, $want) = @ARGV;
  my $read = sub { my $text = do { local $/; open(my $f, "<", $_[0]) or return {}; <$f> }; my $j = eval { decode_json($text) }; ref $j eq "HASH" ? $j : {} };
  my $bytes = sub { my $v = shift; return "" if !defined $v || ref $v; $v = "$v"; utf8::encode($v); $v };
  exit 1 unless length $k && opendir(my $d, $grants);
  for my $name (sort grep { /\.json$/ } readdir $d) {
    my $g = $read->("$grants/$name");
    my ($id, $at) = ($bytes->($g->{id}), $bytes->($g->{at}));
    next unless $at =~ /^\d+$/ && abs(time() * 1000 - $at) <= 120_000;
    next unless $bytes->($g->{host}) eq "release" && $bytes->($g->{command}) eq $want;
    next unless $bytes->($g->{seal}) eq hmac_sha256_hex("release-grant\n$id\n$at\nrelease\n$want", $k);
    next unless rename("$grants/$name", "$grants/$name.$$");
    unlink "$grants/$name.$$";
    print "granted";
    exit 0;
  }
  exit 1;
' "$HOME/.claude/claudopus/admin-grants" "$top
$branch")
# A person releasing by hand, outside Claude Code and at a terminal, says yes there instead; anything else with no grant (a run with no
# terminal, or one inside Claude Code) is refused
if [ "$granted" != granted ] && [ -z "${CLAUDECODE:-}" ] && [ -t 0 ] && [ -t 2 ]; then
  printf 'release: release %s from %s to %s? [y/N] ' "$branch" "$top" "${MAIN:-main}" >&2
  read -r -t 300 yes </dev/tty || yes=
  case $yes in y | Y | yes | Yes) granted=granted ;; esac
fi
[ "$granted" = granted ] || die "refused: nothing was released, because this release was not allowed on its card in the Claudopus panel. Run it as one Bash call of its own from the work's worktree, cd there first if need be: cd $top && $0. The card then shows it and asks." 6

# The guard: in this repo a push of main from inside Claude Code that does not come from release is refused. Put in once,
# only where the repo has no pre-push hook of its own; a person pushing outside Claude Code is never stopped
hooks="$common/hooks"
if [ -n "$(git -C "$top" config core.hooksPath)" ]; then
  say "git here uses hooks from core.hooksPath, so the guard was not put in; Claude Code still refuses a push of $MAIN by hand"
elif [ ! -e "$hooks/pre-push" ]; then
  mkdir -p "$hooks" && cat >"$hooks/pre-push" <<'GUARD' && chmod +x "$hooks/pre-push"
#!/bin/bash
# Put here by Claudopus's release: inside Claude Code, main is pushed only by release, so two pieces of work never release at once
[ -n "${RELEASE_PUSH:-}" ] || [ -z "${CLAUDECODE:-}" ] && exit 0
while read -r _ _ rref _; do
  case "$rref" in refs/heads/main | refs/heads/master | refs/heads/"$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')")
    echo "Work never pushes ${rref#refs/heads/} itself: commit on your own branch and run Claudopus's release from your worktree. (A person outside Claude Code is never stopped; git push --no-verify skips this.)" >&2; exit 1 ;;
  esac
done
exit 0
GUARD
elif ! grep -q "Claudopus's release" "$hooks/pre-push" 2>/dev/null; then
  say "this repo has a pre-push hook of its own, so the guard was not put in"
fi

# Trials only: wait for a go file so two releases start at the same moment, for two minutes at most
if [ -n "${RELEASE_BARRIER:-}" ]; then
  n=0; while [ ! -e "$RELEASE_BARRIER" ] && [ $n -lt 1200 ]; do sleep 0.1; n=$((n + 1)); done
fi

# Releases close together are checked side by side, never one after another: each takes its place in a line, a folder beside
# the lock with a file per release, and builds its commit on the commit of the release ahead of it (or on main when none is),
# so its checks, here and on GitHub, are of the very tree main will have once the one ahead lands, and run while the one ahead
# still checks. It pushes only once the one ahead has pushed and gone. A release ahead that fails or remakes its commit makes each
# one behind it make its own again on what main then is, by itself. The lock is held only while a release reads main and the
# line, makes its commit and takes its place: a minute at most
mkdir -p "$locks"
line="$lock.line"
mkdir -p "$line"
# A line, flushed, at least every RELEASE_BEAT seconds (10, or 1 to 10 for trials) whatever the release is at, saying what:
# `progress: <seconds so far> s <what>`. The waits say it in their own words; a ticker beside the release says the stage it is at
# whenever nothing else was said for a beat (a build, a push, logs read from GitHub)
beat=${RELEASE_BEAT:-10}; case $beat in '' | *[!0-9]* | 0) beat=10 ;; esac; [ "$beat" -gt 10 ] && beat=10
started=$(date +%s) last_tick=0
beatf=
tick() {
  local now; now=$(date +%s)
  [ $((now - last_tick)) -ge "$beat" ] || return 0
  last_tick=$now
  echo "progress: $((now - started)) s $1" >&2
  [ -n "$beatf" ] && : >"$beatf"
  return 0
}
# What the ticker says when the release itself says nothing
stage() { [ -n "$beatf" ] && printf '%s\n' "$1" >"$beatf.stage"; set_me stage "$1"; return 0; }
start_ticker() {
  beatf="$1"; : >"$beatf"; echo "starting" >"$beatf.stage"
  ( trap - EXIT; while kill -0 "$2" 2>/dev/null; do
      sleep "$beat" </dev/null >/dev/null 2>&1
      /usr/bin/perl -e 'my @s = stat shift or exit 1; exit(time - $s[9] < shift ? 0 : 1)' "$beatf" "$beat" && continue
      kill -0 "$2" 2>/dev/null || break
      echo "progress: $(( $(date +%s) - $3 )) s $(cat "$beatf.stage" 2>/dev/null)" >&2; : >"$beatf"
    done ) &
}
# Never longer than 90 minutes in all, whatever it waits for
too_long() { [ $(( $(date +%s) - started )) -gt 5400 ] && { stop_checks; drop_candidate; die "ran 90 minutes without landing; nothing pushed to ${MAIN:-main}" 3; }; return 0; }
have_lock=
take_lock() {
  local waited=0 holder
  # A lock whose release died is cleared by the one waiter that holds the clearing's own lock, after it looks again, so a fresh
  # lock another waiter just took is never cleared
  until mkdir "$lock" 2>/dev/null && echo $$ >"$lock/pid"; do
    holder=$(cat "$lock/pid" 2>/dev/null || true)
    if { [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; } || { [ -z "$holder" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }; then
      [ -n "$(find "$lock.clearing" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$lock.clearing" 2>/dev/null
      if mkdir "$lock.clearing" 2>/dev/null; then
        if [ "$(cat "$lock/pid" 2>/dev/null || true)" = "$holder" ]; then rm -rf "$lock"; say "cleared the lock of a release that ended without letting go"; fi
        rmdir "$lock.clearing"; continue
      fi
    fi
    [ $waited -eq 0 ] && say "waiting: $(cat "$lock/who" 2>/dev/null || echo another release) is taking its place in line"
    tick "waiting for $(cat "$lock/branch" 2>/dev/null || echo another release) to take its place in line"
    sleep 0.5; waited=$((waited + 1)); too_long
  done
  have_lock=1
  echo "$branch from $top, since $(date '+%H:%M:%S')" >"$lock/who"
  printf '%s\n' "$branch" >"$lock/branch"
}
let_go() { [ -n "$have_lock" ] && rm -rf "$lock"; have_lock=; return 0; }

# This release's file in the line (`key=value` lines), and what it reads of another's
me=
val() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }
put_me() { local t="$me.tmp.$$"; printf '%s\n' "$@" >"$t" && mv -f "$t" "$me"; }
set_me() { [ -n "$me" ] && [ -f "$me" ] || return 0; local t="$me.tmp.$$"; { grep -v "^$1=" "$me"; echo "$1=$2"; } >"$t" && mv -f "$t" "$me"; }
# (a release's process by its number and its start time, so a number used again by another process is no release)
started_of() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' '; }
alive() { local p; p=$(val "$1" pid); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && [ "$(started_of "$p")" = "$(val "$1" started)" ]; }
my_start=$(started_of $$)
# The release ahead of this one is settled for this one's commit once it is gone, died, or no longer stands on the commit this one
# built on (it failed and makes its own again)
ahead_settled() { [ -z "${ahead:-}" ] || [ ! -f "$ahead" ] || ! alive "$ahead" || [ "$(val "$ahead" candidate)" != "$base" ] || [ "$(val "$ahead" state)" = redo ]; }
wait_ahead() {
  # $1: gone (until it has ended), settled (as above) or made (until it is no longer making its commit again)
  local a_branch s; a_branch=$(val "$ahead" branch)
  set_me stage "waiting for $a_branch"
  while :; do
    { [ ! -f "$ahead" ] || ! alive "$ahead"; } && break
    [ "$1" = settled ] && ahead_settled && break
    [ "$1" = made ] && [ "$(val "$ahead" state)" != redo ] && break
    s=$(val "$ahead" stage)
    tick "waiting for the release of $a_branch ahead of this one, at ${s:-its end}"
    sleep 1; too_long
  done
}

# A release cut off before it let go left its checkout: one whose own release is gone. One with no note of its release is of the
# runner before the line, which held the lock all through, so none of those runs while this one holds the lock
clear_old_checkouts() {
  git -C "$top" worktree list --porcelain | sed -n 's#^worktree \(.*/claudopus-release\.[^/]*/release\)$#\1#p' | while read -r old; do
    p=$(cat "$(dirname "$old")/pid" 2>/dev/null || true)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && continue
    git -C "$top" worktree remove --force "$old" >/dev/null 2>&1; rm -f "$(dirname "$old")/pid"; rmdir "$(dirname "$old")" 2>/dev/null
  done
  git -C "$top" worktree prune
}
tmp="$(mktemp -d "${TMPDIR:-/tmp}/claudopus-release.XXXXXX")/release"
echo $$ >"$(dirname "$tmp")/pid"
start_ticker "$tmp.beat" $$ "$started"
tpid=$!
# The branch a release's commit waits on GitHub's checks under goes once it is decided, or as the release ends any other way
cref=
drop_candidate() { [ -n "$cref" ] && git -C "$top" push -q "$REMOTE" --delete "$cref" >/dev/null 2>&1; cref=; return 0; }
lpid=
cleanup() {
  [ -n "${tpid:-}" ] && kill "$tpid" 2>/dev/null
  [ -n "$lpid" ] && kill -KILL -- "-$lpid" 2>/dev/null
  drop_candidate
  [ -n "$me" ] && rm -f "$me" "$me.tmp.$$"
  let_go
  git -C "$top" worktree remove --force "$tmp" >/dev/null 2>&1
  rm -rf "$tmp" "$tmp.notes" "$tmp.notes.err" "$tmp.check" "$tmp.check.rc" "$tmp.check.state" "$tmp.release" "$tmp.fails" "$tmp.known" "$tmp".log.* "$tmp.beat" "$tmp.beat.stage"
  rm -f "$(dirname "$tmp")/pid"; rmdir "$(dirname "$tmp")" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

derived() { for d in $DERIVED; do [ "$1" = "$d" ] && return 0; done; return 1; }
getv() { perl -ne 'if (/"version"\s*:\s*"(\d+\.\d+\.\d+)"/ || /^(\d+\.\d+\.\d+)\s*$/) { print $1; exit }' "$1"; }
setv() { perl -0pi -e 's/("version"\s*:\s*")\d+\.\d+\.\d+"/${1}'"$2"'"/ or s/^\d+\.\d+\.\d+$/'"$2"'/m' "$1"; }
gained() { [ -n "$(git -C "$top" merge-base "$branch" "$REMOTE/$MAIN" 2>/dev/null)" ] || return 0; git -C "$top" log --no-merges --format='  %h %s' "$(git -C "$top" merge-base "$branch" "$REMOTE/$MAIN")..$REMOTE/$MAIN" | cut -c1-150 | head -12; }

# gh as installed, never one the caller's PATH puts first, with nothing of the caller's that sends it to another server, account
# folder or proxy; and no call to it hangs the release
gh_bin=$(for g in /opt/homebrew/bin/gh /usr/local/bin/gh /usr/bin/gh; do [ -x "$g" ] && { echo "$g"; break; }; done)
ghq() { env -u GH_HOST -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN -u GH_CONFIG_DIR -u XDG_CONFIG_HOME -u GH_REPO -u GH_DEBUG \
  -u HTTPS_PROXY -u HTTP_PROXY -u ALL_PROXY -u https_proxy -u http_proxy -u all_proxy -u SSL_CERT_FILE -u SSL_CERT_DIR \
  /usr/bin/perl -e 'my $p = fork // exit 127; if (!$p) { setpgrp(0, 0); exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "KILL", -$p }; alarm 60; waitpid $p, 0; exit($? & 127 ? 124 : $? >> 8)' "$gh_bin" "$@"; }
# The wait for GitHub's checks on one commit ends 40 minutes after they were started; RELEASE_CHECK_WAIT (seconds) can make it
# shorter, never longer
wait_s=${RELEASE_CHECK_WAIT:-2400}; case $wait_s in '' | *[!0-9]* | 0) wait_s=2400 ;; esac; [ "$wait_s" -gt 2400 ] && wait_s=2400
every=${RELEASE_CHECK_EVERY:-15}; case $every in '' | *[!0-9]* | 0) every=15 ;; esac; [ "$every" -gt 60 ] && every=60
# What failed in a run of GitHub's checks, a line each, sorted: `<job>: <test file>: <test>` for each failed test the mod's test
# kit names, `<job>: <test>` for a shell test's FAIL or NOT OK line, `<job>: <file>.test.sh failed` for a shell test file that
# failed. What names no test is `unnamed <job>: ...` (a job that failed before its tests, a log not read, a named check skipped or
# missing), and is never taken as main's: a failure only known by name can be told apart. Exit 1 when the run could not be read
fails_of_run() {
  local jobs id name concl steps logf
  jobs=$(ghq api --paginate "repos/$repo/actions/runs/$1/jobs?per_page=100" --jq '.jobs[] | [.id, .name, .status, (.conclusion // "none"), ([.steps[]? | select(.conclusion == "failure") | .name] | join("|"))] | @tsv' 2>/dev/null) || return 1
  logf="$tmp.log.$1"
  {
    printf '%s\n' "$jobs" | while IFS="$(printf '\t')" read -r id name status concl steps; do
      [ -n "$id" ] || continue
      case ",$GITHUB_CHECKS," in *", $name,"* | *",$name,"*) named=1 ;; *) named= ;; esac
      [ "$status" = completed ] || { echo "unnamed $name: not ended"; continue; }
      case $concl in success) continue ;; skipped | neutral) [ -n "$named" ] && echo "unnamed $name: $concl"; continue ;; esac
      # (gh refuses to print a log holding the terminal's colour codes, as GitHub's do, unless told it may; an older gh knows no such
      # word and prints them anyway)
      ghq api --allow-escape-sequences "repos/$repo/actions/jobs/$id/logs" >"$logf" 2>/dev/null || ghq api "repos/$repo/actions/jobs/$id/logs" >"$logf" 2>/dev/null || { echo "unnamed $name: log not read"; continue; }
      # A failure counts by name only where the log names every one: the mod's tests' own count of failures must equal the failures
      # named, a shell test that failed must have named what failed in its own group of lines, and any other error line names nothing
      /usr/bin/perl -ne 'BEGIN { $j = shift } s/^(?:\xef\xbb\xbf)?\d{4}-\d\d-\d\dT[\d:.]+Z //; s/\e\[[\d;]*m//g; s/\r?\n$//;
        if (/^##\[group\](\S+\.test\.sh)\s*$/) { $g = $1; next }
        if (/^##\[endgroup\]/) { $g = undef; next }
        if (/^(\S+\.test\.tsx):\s*$/) { $f = $1; next }
        if (/^FAIL (.+?)\s*$/) { print "$j: $1\n"; $n++; $in{$g}++ if defined $g }
        elsif (/^NOT OK (?:\d+ )?-? ?(.+?)(?:: ended \d+.*)?\s*$/) { print "$j: $1\n"; $n++; $in{$g}++ if defined $g }
        elsif (/^\(fail\) (.+?)(?: \[[\d.]+m?s\])?\s*$/) { print "$j: ", ($f // "?"), ": $1\n"; $n++; $named++ }
        elsif (/^ *(\d+) fail\s*$/) { $count = $1 }
        elsif (/^(?:##\[error\]|::error::)(\S+\.test\.sh) failed\s*$/) { print $in{$1} ? "$j: $1 failed\n" : "unnamed $j: $1 failed, naming no test\n"; $n++ }
        elsif (/^(?:##\[error\]|::error::)(.*)$/ && $1 !~ /^Process completed with exit code \d+\.?$/) { print "unnamed $j: $1\n"; $n++ }
        END { print "unnamed $j: the mod'"'"'s tests failed ", ($count // "uncounted"), " where ", ($named // 0), " are named\n" if ($count // -1) != ($named // 0) && ($count || $named); exit($n ? 0 : 1) }' "$name" "$logf" ||
        { if [ -n "$steps" ]; then printf '%s\n' "$steps" | tr '|' '\n' | sed "s#^#unnamed $name: step #"; else echo "unnamed $name: $concl"; fi; }
    done
    # a named check with no job at all
    for want in $(printf '%s' "$GITHUB_CHECKS" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | tr ' ' '\001'); do
      want=$(printf '%s' "$want" | tr '\001' ' ')
      printf '%s\n' "$jobs" | cut -f2 | grep -qxF "$want" || echo "unnamed $want: missing"
    done
  } | sort -u
  rm -f "$logf"
}
# What already failed on the commit this release built on, in its own checks on GitHub (its run on the push to main, and the
# release's run that checked it before): main's failures, which this release did not bring. Exit 1 while one of those runs is still
# going; nothing when they passed or none is found
known_fails() {
  local runs id status concl
  runs=$( { ghq api "repos/$repo/actions/workflows/$workflow/runs?head_sha=$base&event=push&per_page=20" --jq '.workflow_runs[] | select(.path == ".github/workflows/'"$workflow"'") | [.id, .status, (.conclusion // "")] | @tsv' 2>/dev/null
    ghq api "repos/$repo/actions/workflows/$workflow/runs?event=workflow_dispatch&branch=$MAIN&per_page=50" --jq '.workflow_runs[] | select(.display_title == "Release check '"$base"'" and .path == ".github/workflows/'"$workflow"'") | [.id, .status, (.conclusion // "")] | @tsv' 2>/dev/null; } | grep -E '^[0-9]+	')
  : >"$tmp.known"
  # (the runs that ended are enough; one still going is waited for only when none has ended)
  local ended=0 going=0
  while IFS="$(printf '\t')" read -r id status concl; do
    [ -n "$id" ] || continue
    [ "$status" = completed ] || { going=1; continue; }
    ended=1
    [ "$concl" = success ] && continue
    fails_of_run "$id" >>"$tmp.known" || return 1
  done <<EOF
$runs
EOF
  [ $ended = 0 ] && [ $going = 1 ] && return 1
  sort -u -o "$tmp.known" "$tmp.known"
}

# The checks here run on the very commit made below; with GITHUB_CHECKS, while GitHub checks that commit, so neither waits for
# the other. They run in a process group of their own, made before they start (job control sets it from this side too), so a red
# check on GitHub, a moved main or the end of this release stops every one of them, and their group stops itself once this
# release is gone, however it ended. One release's at a time on this Mac (a lock of their own beside the line's): the mod's
# tests side by side twice over would slow each other past their limits
start_checks() {
  lpid=; rm -f "$tmp.check" "$tmp.check.rc" "$tmp.check.state"
  [ -n "$CHECK" ] || return 0
  set -m
  # (the lock names its holder by number and start time; one whose holder is gone is moved aside, which only one waiter can do,
  # then removed; its holder removes it as it ends however it ends, short of a KILL)
  bash -c 'm=$4
    st() { ps -o lstart= -p "$1" 2>/dev/null | tr -s " "; }
    until mkdir "$m" 2>/dev/null; do
      h=$(cat "$m/pid" 2>/dev/null); hs=$(cat "$m/started" 2>/dev/null)
      # (cleared by the one waiter holding the lock of the clearing, after it reads the holder again, so a fresh lock is never cleared)
      if { [ -n "$h" ] && { ! kill -0 "$h" 2>/dev/null || [ "$(st "$h")" != "$hs" ]; }; } || { [ -z "$h" ] && [ -n "$(find "$m" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }; then
        [ -n "$(find "$m.clearing" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$m.clearing" 2>/dev/null
        if mkdir "$m.clearing" 2>/dev/null; then
          [ "$(cat "$m/pid" 2>/dev/null)" = "$h" ] && [ "$(cat "$m/started" 2>/dev/null)" = "$hs" ] && rm -rf "$m"
          rmdir "$m.clearing"; continue
        fi
      fi
      kill -0 "$3" 2>/dev/null || exit 1
      echo "waiting for another release'"'"'s checks on this Mac" >"$2.state"; sleep 1
    done
    trap "rm -rf \"$m\"" EXIT; trap "exit 1" TERM INT HUP
    st $$ >"$m/started"; echo $$ >"$m/pid"; echo "running" >"$2.state"
    bash -c "$1" >"$2" 2>&1 & c=$!
    while kill -0 $c 2>/dev/null; do kill -0 "$3" 2>/dev/null || { rm -rf "$m"; kill -KILL 0; }; sleep 1; done
    wait $c; r=$?; echo $r >"$2.rc"' sh "$CHECK" "$tmp.check" "$$" "$lock.mac" &
  lpid=$!
  set +m
}
mac_state() {
  [ -n "${lpid:-}" ] || { echo "passed"; return; }
  if [ -s "$tmp.check.rc" ]; then [ "$(cat "$tmp.check.rc")" = 0 ] && echo passed || echo failed; else cat "$tmp.check.state" 2>/dev/null || echo starting; fi
}
# Stops the checks' whole group and returns only once none of it is left (TERM, then KILL after five seconds)
stop_checks() {
  [ -n "${lpid:-}" ] || return 0
  local n=0
  while kill -0 -- "-$lpid" 2>/dev/null; do
    if [ $n -lt 25 ]; then kill -TERM -- "-$lpid" 2>/dev/null; else kill -KILL -- "-$lpid" 2>/dev/null; fi
    sleep 0.2; n=$((n + 1))
  done
  wait "$lpid" 2>/dev/null; lpid=; return 0
}
# This Mac's checks to their end, saying how far they got: 0 passed, 1 failed (their last lines said)
end_checks() {
  if [ -n "${lpid:-}" ]; then
    stage "this Mac's checks"
    while kill -0 "$lpid" 2>/dev/null; do tick "this Mac's checks $(mac_state)"; sleep 1; too_long; done
    wait "$lpid"; lpid=
    [ "$(cat "$tmp.check.rc" 2>/dev/null)" = 0 ] || { tail -25 "$tmp.check" >&2; return 1; }
  fi
  [ "$(git rev-parse HEAD)" = "$candidate" ] && git diff --quiet HEAD -- && git diff --cached --quiet HEAD -- || { drop_candidate; die "the checks changed the release's commit or its files; nothing pushed" 3; }
  [ -n "$(git ls-files --others --exclude-standard)" ] && { drop_candidate; die "the checks left files the repo does not track; nothing pushed" 3; }
  return 0
}
# A failure of this release's commit while the one ahead of it has not landed may be that one's: wait for it, then make the commit
# again on what main is (0, the caller goes round again) unless main is now exactly what this one built on, when the failure is
# this one's (1)
again_after_ahead() {
  [ -n "${ahead:-}" ] || return 1
  say "$1, on top of the release of $(val "$ahead" branch) ahead of it: waiting for that one to end, to see whose it is"
  wait_ahead gone
  git -C "$top" fetch -q "$REMOTE" "+refs/heads/$MAIN:refs/remotes/$REMOTE/$MAIN" || die "could not fetch $REMOTE/$MAIN"
  [ "$(git -C "$top" rev-parse "$REMOTE/$MAIN")" = "$base" ] && { ahead=; return 1; }
  stop_checks; drop_candidate
  set_me state redo; cd "$top" || exit 1
  say "the release ahead did not land; making this one again on main"
  return 0
}

# The checks read and the lock are of the repo pushed to
[ "$(git -C "$top" remote get-url --push "$REMOTE" 2>/dev/null)" = "$url" ] || die "$REMOTE pushes somewhere other than it fetches from; nothing done"
try=0
while :; do
  try=$((try + 1))
  [ $try -gt 12 ] && die "main or the releases ahead kept moving; gave up after 12 tries; nothing pushed"
  too_long
  candidate=
  stage "waiting to take its place in line"
  take_lock
  if [ $try -eq 1 ]; then clear_old_checkouts; fi
  if [ -z "$(git -C "$top" ls-remote --heads "$REMOTE" "$MAIN" 2>/dev/null)" ]; then
    git -C "$top" ls-remote "$REMOTE" >/dev/null 2>&1 || die "could not reach $REMOTE"
    # A repo with no main yet: the branch becomes its first main as it is
    out=$(RELEASE_PUSH=1 git -C "$top" push -q "$REMOTE" "refs/heads/$branch:refs/heads/$MAIN" 2>&1) || die "the first push of $MAIN was refused: $out"
    git -C "$top" fetch -q "$REMOTE" "$MAIN"
    echo "released $branch as the first $MAIN, $(git -C "$top" rev-parse --short "$branch")"
    exit 0
  fi
  git -C "$top" fetch -q "$REMOTE" "+refs/heads/$MAIN:refs/remotes/$REMOTE/$MAIN" || die "could not fetch $REMOTE/$MAIN"
  on_main=$(git -C "$top" rev-parse "$REMOTE/$MAIN")
  # The release ahead: the last one in the line before this one's own place whose release still runs (the line's files of ended ones go)
  ahead=
  # (by number: this one's own place may not have its file yet, and none after it is ahead of it)
  for e in $(ls "$line" 2>/dev/null | grep -E '^[0-9]{8}$' | sort); do
    [ -n "$me" ] && [ ! "$e" \< "${me##*/}" ] && break
    alive "$line/$e" || { rm -f "$line/$e"; continue; }
    ahead="$line/$e"
  done
  base=$on_main
  if [ -n "$ahead" ]; then
    a_cand=$(val "$ahead" candidate)
    # One ahead that is making its commit again, or made it where this checkout cannot build on it (another clone, or not on the
    # main seen here), is waited for before this one takes its place again
    if [ "$(val "$ahead" state)" = redo ] || [ -z "$a_cand" ] || ! git -C "$top" cat-file -e "$a_cand^{commit}" 2>/dev/null || ! git -C "$top" merge-base --is-ancestor "$on_main" "$a_cand" 2>/dev/null; then
      let_go
      if [ "$(val "$ahead" state)" = redo ]; then wait_ahead made; else wait_ahead gone; fi
      # (a wait is no try)
      try=$((try - 1))
      continue
    fi
    base=$a_cand
  fi
  # This release's place: the next number in the line, kept across its tries so the ones behind it stay behind
  # (past both the count kept and the highest place taken, so a count cut short never gives a place already taken)
  if [ -z "$me" ]; then
    n=$(cat "$line/seq" 2>/dev/null); case $n in '' | *[!0-9]*) n=0 ;; esac
    hi=$(ls "$line" 2>/dev/null | grep -E '^[0-9]{8}$' | sort | tail -1 | sed 's/^0*//'); [ "${hi:-0}" -gt "$n" ] && n=$hi
    n=$((n + 1)); echo "$n" >"$line/seq.$$" && mv -f "$line/seq.$$" "$line/seq"
    me="$line/$(printf %08d "$n")"
  fi
  stage "building"
  [ -n "$(git -C "$top" rev-list -1 "$base..$branch")" ] || die "$branch has nothing $MAIN lacks"
  if [ -d "$tmp" ]; then cd "$tmp" && git merge --abort >/dev/null 2>&1; git -C "$tmp" reset -q --hard "$base"; git -C "$tmp" clean -qfdx
  else git -C "$top" worktree add -q --detach "$tmp" "$base" >/dev/null 2>&1 || die "could not make the release's own checkout"; fi
  cd "$tmp" || die "no checkout"
  # The checks and build are main's own, read from main's committed .release as values only, so a branch (this one, or one ahead
  # of it in the line) cannot drop or change them or run anything of its own; this Mac's own still apply. Where and what is pushed
  # stay as this Mac set them
  keep_main=$MAIN keep_remote=$REMOTE keep_after=$AFTER
  BUILD= CHECK= DERIVED= VERSION_FILE= NAME= GITHUB_RELEASE= GITHUB_CHECKS= CHECKS_WORKFLOW=
  git show "$on_main:.release" >"$tmp.release" 2>/dev/null && settings_of "$tmp.release" "NAME VERSION_FILE DERIVED BUILD CHECK GITHUB_RELEASE GITHUB_CHECKS CHECKS_WORKFLOW"
  rm -f "$tmp.release"
  # This Mac's own file can add checks to wait for, never drop the ones main names
  main_checks=$GITHUB_CHECKS main_workflow=$CHECKS_WORKFLOW
  settings_of "$common/release.local" "NAME VERSION_FILE DERIVED BUILD CHECK GITHUB_RELEASE GITHUB_CHECKS CHECKS_WORKFLOW"
  # and the workflow that checks is main's, where main names one
  [ -n "$main_checks" ] && CHECKS_WORKFLOW=$main_workflow
  [ -n "$main_checks" ] && [ "$GITHUB_CHECKS" != "$main_checks" ] && GITHUB_CHECKS="$main_checks${GITHUB_CHECKS:+,$GITHUB_CHECKS}"
  [ -z "$GITHUB_CHECKS" ] || [ -n "$(printf %s "$GITHUB_CHECKS" | tr -d ', \t\n\r')" ] || die "GITHUB_CHECKS names no check; nothing pushed" 3
  MAIN=$keep_main REMOTE=$keep_remote AFTER=$keep_after
  if ! out=$(git merge -q --no-ff --no-commit "$branch" 2>&1); then
    git rev-parse -q --verify MERGE_HEAD >/dev/null || die "git would not merge $branch onto $MAIN: $out" 1
    real=""
    for f in $(git diff --name-only --diff-filter=U); do
      if derived "$f"; then git checkout -q "$base" -- "$f" 2>/dev/null || git rm -q -- "$f"
      elif [ "$f" = "$VERSION_FILE" ]; then
        # Main's number on all three sides, so only the rest of the file merges: an edit beside the version line is no conflict
        v=$(git show "$base:$f" >"$tmp.m" && getv "$tmp.m"); git show ":1:$f" >"$tmp.b" 2>/dev/null || cp "$tmp.m" "$tmp.b"; git show ":3:$f" >"$tmp.t"
        for side in "$tmp.m" "$tmp.b" "$tmp.t"; do [ -n "$v" ] && setv "$side" "$v"; done
        if git merge-file -q "$tmp.m" "$tmp.b" "$tmp.t"; then cp "$tmp.m" "$f" && git add -- "$f"; else real="$real $f"; fi
        rm -f "$tmp.m" "$tmp.b" "$tmp.t"
      else real="$real $f"; fi
    done
    if [ -n "$real" ]; then
      git merge --abort >/dev/null 2>&1
      let_go
      again_after_ahead "$branch and the release ahead of it changed the same lines:$real" && continue
      say "$branch and $MAIN both changed:$real. Nothing was pushed."
      say "what $MAIN gained since $branch left it:"; gained >&2
      die "merge $REMOTE/$MAIN into $branch, keep what both meant, build, test, commit, then run release again" 2
    fi
  fi
  git rev-parse -q --verify MERGE_HEAD >/dev/null || die "git would not merge $branch onto $MAIN" 1
  # What the build makes is never merged: it starts from main's copy and the build makes it again
  for f in $DERIVED; do git cat-file -e "$base:$f" 2>/dev/null && git checkout -q "$base" -- "$f"; done
  ver=""
  if [ -n "$VERSION_FILE" ]; then
    # The number is the base's plus one (main's, or the release's ahead), whatever the branch wrote; the rest of the file merges as
    # any file does
    old=$(git show "$base:$VERSION_FILE" 2>/dev/null > "$tmp.v" && getv "$tmp.v"; rm -f "$tmp.v")
    [ -n "$old" ] || old=$(getv "$VERSION_FILE")
    [ -n "$old" ] || die "no version in $VERSION_FILE"
    ver=$(echo "$old" | awk -F. '{ print $1 "." $2 "." $3 + 1 }')
    setv "$VERSION_FILE" "$ver"
  fi
  if [ -n "$BUILD" ]; then
    if ! out=$(bash -c "$BUILD" 2>&1); then
      echo "$out" | tail -20 >&2
      git merge --abort >/dev/null 2>&1; let_go
      again_after_ahead "the build failed" && continue
      die "the build failed on $MAIN with $branch; nothing pushed" 3
    fi
  fi
  for f in $DERIVED; do [ -e "$f" ] && git add -- "$f"; done
  stray=$(git ls-files --others --exclude-standard)
  [ -n "$stray" ] && die "the build left files the repo does not track: $(echo $stray | cut -c1-300). Nothing pushed." 3
  git add -u
  # The GitHub release's notes and gh's sign-in are made sure of before the push, so a release that cannot make its GitHub
  # release pushes nothing
  notes="$tmp.notes"
  if [ -n "$GITHUB_RELEASE" ] && [ -n "$ver" ]; then
    RELEASE_VERSION=$ver bash -c "$GITHUB_RELEASE" >"$notes" 2>"$notes.err" && [ -s "$notes" ] || { tail -5 "$notes.err" >&2; die "the GitHub release notes for $ver could not be made; nothing pushed" 3; }
    command -v gh >/dev/null || die "GITHUB_RELEASE is set but gh is not installed; nothing pushed" 3
    gh auth status >/dev/null 2>&1 || die "gh is not signed in to GitHub (gh auth login), so the GitHub release could not be made; nothing pushed" 3
    # owner/repo is the remote URL's last two parts, whatever its form (https, ssh, an ssh host alias)
    repo=$(printf %s "$url" | sed -E 's#/+$##; s#\.git$##' | awk -F'[/:]' '{ print $(NF-1) "/" $NF }')
    [ "$(gh api "repos/$repo" --jq .permissions.push 2>/dev/null)" = true ] || die "gh cannot write to $repo on GitHub, so its release could not be made; nothing pushed" 3
  fi
  what=${title:-$(git log --no-merges -1 --format=%s "$base..$branch")}
  label=${NAME:+$NAME }${ver:+$ver: }
  git commit -q -m "${label}${what}" -m "Released from $branch by release, on $(git rev-parse --short "$on_main")${ahead:+ with the release of $(val "$ahead" branch) ahead of it}." || die "nothing to commit"
  candidate=$(git rev-parse HEAD)
  # In line: what it built on and its commit, read by the ones behind it, then the lock goes
  put_me "pid=$$" "started=$my_start" "branch=$branch" "base=$base" "candidate=$candidate" "ver=$ver" "state=checking" "stage=checking"
  let_go
  [ -n "$ahead" ] && say "checking side by side with the release of $(val "$ahead" branch) ahead of it, on top of it"
  # GitHub's own checks on the very commit main is to become, before main moves, run by main's own workflow (CHECKS_WORKFLOW), never
  # the branch's: the commit goes to a ref outside the branches (which starts no workflow), main's workflow is started on it, and
  # main is pushed only once every job of that run passed with every named check among them, or failed only where the commit it
  # was built on already fails (main's own failures, which never hold up a release that adds none). Red otherwise, a named one
  # missing, or still running when the wait ends, and nothing is pushed to main
  verdict=green
  if [ -n "$GITHUB_CHECKS" ]; then
    [ -n "$gh_bin" ] || die "GITHUB_CHECKS is set but gh is not installed; nothing pushed" 3
    ghq auth status >/dev/null 2>&1 || die "gh is not signed in to GitHub (gh auth login), so its checks cannot be read; nothing pushed" 3
    repo=$(printf %s "$url" | sed -E 's#/+$##; s#\.git$##' | awk -F'[/:]' '{ print $(NF-1) "/" $NF }')
    workflow=${CHECKS_WORKFLOW:-check.yml}
    cref="refs/release-check/${ver:-x}-$(git rev-parse --short HEAD)"
    out=$(git push -q "$REMOTE" "HEAD:$cref" 2>&1) || { echo "$out" | tail -5 >&2; cref=; die "could not push $candidate for GitHub to check; nothing pushed to $MAIN" 3; }
    # Runs made before this dispatch are never taken (a minute's leeway for GitHub's clock)
    since=$(date -u -r $(( $(date +%s) - 60 )) +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$(( $(date +%s) - 60 ))" +%Y-%m-%dT%H:%M:%SZ)
    out=$(ghq api -X POST "repos/$repo/actions/workflows/$workflow/dispatches" -f "ref=refs/heads/$MAIN" -f "inputs[sha]=$candidate" 2>&1) || { echo "$out" | tail -5 >&2; die "GitHub would not start $workflow on $MAIN for $(git rev-parse --short HEAD); nothing pushed to $MAIN" 3; }
    start_checks
    check_deadline=$(( $(date +%s) + wait_s ))
    verdict=; run=; looked=0
    stage "GitHub's checks"
    say "waiting for GitHub's checks ($workflow as on $MAIN) on $(git rev-parse --short HEAD): ${GITHUB_CHECKS}"
    while [ "$(date +%s)" -lt "$check_deadline" ]; do
      # The one ahead failed or makes its commit again: this commit, on top of it, is no longer the one main will have
      if [ -n "$ahead" ] && ahead_settled; then
        git -C "$top" fetch -q "$REMOTE" "+refs/heads/$MAIN:refs/remotes/$REMOTE/$MAIN"
        if [ "$(git -C "$top" rev-parse "$REMOTE/$MAIN")" = "$base" ]; then ahead=; else verdict=redo; break; fi
      fi
      # This Mac's checks failed while GitHub still checks: decided now, without waiting for GitHub
      if [ -n "$lpid" ] && [ -s "$tmp.check.rc" ] && [ "$(cat "$tmp.check.rc")" != 0 ]; then verdict=mac; break; fi
      if [ $(( $(date +%s) - looked )) -ge "$every" ]; then
        looked=$(date +%s)
        # The run is main's own: started by a dispatch on main, of main's workflow file, since this release's dispatch, named for the
        # very commit, on a main this commit stands on. One started on any other branch or tag, or before, never counts; two that
        # fit are refused
        if [ -z "$run" ] && found=$(ghq api "repos/$repo/actions/workflows/$workflow/runs?event=workflow_dispatch&branch=$MAIN&per_page=50" --jq ".workflow_runs[] | select(.display_title == \"Release check $candidate\" and .head_branch == \"$MAIN\" and .path == \".github/workflows/$workflow\" and .event == \"workflow_dispatch\" and .created_at >= \"$since\") | [.id, .head_sha] | @tsv" 2>/dev/null); then
          found=$(printf '%s\n' "$found" | grep -E '^[0-9]+	[0-9a-f]{40}$')
          if [ "$(printf '%s\n' "$found" | grep -c .)" -gt 1 ]; then verdict="red: more than one run of $workflow on $MAIN is named for $(git rev-parse --short HEAD)"; break; fi
          if [ -n "$found" ]; then
            run=${found%%	*}
            # Started on a main this commit does not stand on: the push below would be refused anyway; taken again from the newer main
            git -C "$top" merge-base --is-ancestor "${found#*	}" "$candidate" 2>/dev/null || { verdict=moved; break; }
          fi
        fi
        runs=; state=
        if [ -n "$run" ]; then
          state=$(ghq api "repos/$repo/actions/runs/$run" --jq '[.status, (.conclusion // "")] | @tsv' 2>/dev/null) || state=
          runs=$(ghq api --paginate "repos/$repo/actions/runs/$run/jobs?per_page=100" --jq '.jobs[] | [.name, .status, (.conclusion // ""), .html_url] | @tsv' 2>/dev/null) || runs=
        fi
        # pass: the run passed, every named check is in it and passed, and no other job failed; red: a job failed and none runs any more
        # (what failed is then compared with main's, whole), or the run ended without a named check; else wait (a list gh could not
        # read whole is waited on, never judged)
        verdict=$(printf '%s\n' "$runs" | RUN_STATE=$state NAMES=$GITHUB_CHECKS /usr/bin/perl -F'\t' -lane '
          BEGIN { %want = map { s/^\s+|\s+$//g; ($_ => 1) } grep { /\S/ } split /,/, $ENV{NAMES} }
          next unless @F >= 2; $seen{$F[0]} = 1;
          if ($F[1] ne "completed") { push @busy, $F[0]; next }
          if ($F[2] !~ /^(success|skipped|neutral)$/ || ($want{$F[0]} && $F[2] ne "success")) { push @red, "$F[0] ($F[2]) $F[3]" }
          END {
            my @missing = grep { !$seen{$_} } sort keys %want;
            my ($status, $conclusion) = split /\t/, $ENV{RUN_STATE} // "";
            if (@red && !@busy) { print "red: ", join("; ", @red), (@missing ? "; missing: " . join(", ", @missing) : ""); exit }
            if (@missing && !@busy && ($status // "") eq "completed") { print "red: the run ended with ", join(", ", map { "$_ not started" } @missing); exit }
            if (@busy || @missing) { print "wait: ", join(", ", (map { "$_ failed" } map { (split / \(/)[0] } @red), (map { "$_ running" } @busy), (map { "$_ not started" } @missing)); exit }
            if (($status // "") ne "completed") { print "wait: the run not ended"; exit }
            if (($conclusion // "") ne "success") { print "red: the run ended ", ($conclusion || "without a conclusion"); exit }
            print "green" }')
        [ -n "$run" ] || verdict="wait: not started yet"
        case $verdict in green | red:*) break ;; esac
      fi
      tick "waiting for GitHub's checks: ${verdict#wait: }; this Mac's checks $(mac_state)"
      sleep 1; too_long
    done
    # (this Mac's checks go on to be read below, unless what was decided leaves them nothing to decide)
    case $verdict in green | red:* | mac) ;; *) stop_checks ;; esac
    case $verdict in
      green) say "GitHub's checks passed on $(git rev-parse --short "$candidate"): ${GITHUB_CHECKS}" ;;
      redo) drop_candidate; set_me state redo; cd "$top" || exit 1; say "the release ahead of it did not land; making this one again on main (try $try)"; continue ;;
      moved) drop_candidate; set_me state redo; cd "$top" || exit 1; say "$MAIN moved while GitHub checked; taking it again (try $try)"; continue ;;
      mac) : ;;
      red:*)
        red=${verdict#red: }
        # Whose failure: with one ahead still checking, it may be that one's; else the ones the commit it was built on already has are
        # main's, and only a failure of this release's own holds it up
        again_after_ahead "GitHub's checks failed" && continue
        stage "comparing GitHub's failures with main's"
        say "GitHub's checks failed: $red. Comparing with what already fails on the commit it was built on, $(git rev-parse --short "$base")"
        fails_of_run "$run" >"$tmp.fails" || : >"$tmp.fails"
        until known_fails; do
          [ "$(date +%s)" -lt "$check_deadline" ] || { stop_checks; drop_candidate; die "GitHub's checks failed on $MAIN with $branch, and main's own run did not end in time to compare; nothing pushed to $MAIN: $red" 3; }
          tick "waiting for main's own checks to end, to compare failures"; sleep 1; too_long
        done
        # (what names no test is this release's to answer for, whatever main has)
        new=$( { grep '^unnamed ' "$tmp.fails"; comm -23 "$tmp.fails" "$tmp.known" | grep -v '^unnamed '; } | sort -u)
        if [ ! -s "$tmp.fails" ] || [ -n "$new" ]; then
          stop_checks; drop_candidate
          [ -s "$tmp.known" ] && say "main already fails: $(tr '\n' ';' <"$tmp.known" | cut -c1-600)"
          die "GitHub's checks failed on $MAIN with $branch, so nothing was pushed to $MAIN: ${new:+what this release brings: $(printf '%s\n' "$new" | tr '\n' ';' | cut -c1-600) }$red" 3
        fi
        say "GitHub's checks failed only where main already fails ($(tr '\n' ';' <"$tmp.known" | cut -c1-600)); this release brings no failure of its own, so it goes on"
        ;;
      *) drop_candidate; die "GitHub's checks did not end in time (${verdict#wait: }); nothing pushed to $MAIN" 3 ;;
    esac
  else
    start_checks
  fi
  if ! end_checks; then
    again_after_ahead "this Mac's checks failed" && continue
    drop_candidate; die "the checks failed on $MAIN with $branch; nothing pushed" 3
  fi
  # Its turn: the one ahead has pushed and gone (main is then the commit this one stands on), or did not land, and this one is made
  # again on main
  if [ -n "$ahead" ]; then
    set_me state passed
    wait_ahead gone
    git -C "$top" fetch -q "$REMOTE" "+refs/heads/$MAIN:refs/remotes/$REMOTE/$MAIN"
    if [ "$(git -C "$top" rev-parse "$REMOTE/$MAIN")" != "$base" ]; then
      drop_candidate; set_me state redo; cd "$top" || exit 1
      say "the release ahead of it did not land; making this one again on main (try $try)"; continue
    fi
  fi
  # What goes to main and is tagged is the commit the checks passed on, never whatever the checkout holds after the wait
  [ "$(git rev-parse HEAD)" = "$candidate" ] || { drop_candidate; die "the release's checkout moved while GitHub checked it; nothing pushed to $MAIN" 3; }
  stage "pushing"
  if pushed=$(RELEASE_PUSH=1 git push -q "$REMOTE" "$candidate:refs/heads/$MAIN" 2>&1); then
    drop_candidate
    set_me state pushed
    sha=$(git rev-parse --short "$candidate")
    failed=""
    if [ -n "$ver" ]; then
      kept="$common/release-notes-v$ver.md"
      retry="gh release create v$ver --repo \"${repo:-}\" --title \"${NAME:+$NAME }$ver\" --notes-file \"$kept\" --latest --verify-tag"
      if ! { git tag -f "v$ver" "$candidate" >/dev/null && RELEASE_PUSH=1 git push -q "$REMOTE" "v$ver" 2>/dev/null; }; then
        failed="RELEASE FAILED: $MAIN was pushed as $sha, but its tag v$ver was not. Finish it with: git push $REMOTE $sha:refs/tags/v$ver"
        [ -n "$GITHUB_RELEASE" ] && { cp "$notes" "$kept"; failed="$failed, then: $retry"; }
      elif [ -n "$GITHUB_RELEASE" ]; then
        if ! out=$(gh release create "v$ver" --repo "$repo" --title "${NAME:+$NAME }$ver" --notes-file "$notes" --latest --verify-tag 2>&1) \
          && ! gh release view "v$ver" --repo "$repo" >/dev/null 2>&1; then
          cp "$notes" "$kept"; echo "$out" | tail -5 >&2
          failed="RELEASE FAILED: $MAIN and tag v$ver were pushed, but GitHub's release for v$ver was not made. Finish it with: $retry"
        elif [ "$(gh release view --repo "$repo" --json tagName --jq .tagName 2>/dev/null)" != "v$ver" ]; then
          failed="RELEASE FAILED: GitHub's release for v$ver was made, but GitHub does not show it as the latest. Mark it with: gh release edit v$ver --repo $repo --latest"
        else
          say "GitHub's latest release is now v$ver"
        fi
      fi
    fi
    rm -f "$notes" "$notes.err"
    git -C "$top" fetch -q "$REMOTE" "$MAIN"
    echo "released ${label}${what} as $sha after $(( $(date +%s) - started )) s"
    [ "$NAME" = Claudopus ] && [ -n "${ver:-}" ] && echo "Claudopus $ver is out: once the panel shows it (at its next look, or at once with Config's Check now), press Update, then type /reload-plugins in each open chat."
    # The ones behind it go on while its after-step runs
    rm -f "$me"; me=
    cd "$top" || exit 0
    if [ -n "$AFTER" ]; then bash -c "$AFTER" || say "released, but the after-step failed"; fi
    [ -n "$failed" ] && die "$failed" 4
    exit 0
  fi
  drop_candidate
  set_me state redo
  cd "$top" || exit 1
  git -C "$top" fetch -q "$REMOTE" "+refs/heads/$MAIN:refs/remotes/$REMOTE/$MAIN"
  if [ "$(git -C "$top" rev-parse "$REMOTE/$MAIN")" = "$base" ]; then
    echo "$pushed" | tail -8 >&2
    die "$REMOTE refused the push of $MAIN, and $MAIN had not moved; nothing pushed. If $MAIN takes only pull requests, merging one is for the person to do"
  fi
  say "$MAIN moved while I released, from another Mac or a push outside release; what landed:"; gained >&2
  say "taking it again (try $try)"
done
