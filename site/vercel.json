{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/og/leaderboard.png",
      "destination": "https://wezffxcyofkyhoowwjwi.supabase.co/functions/v1/lb-card"
    },
    {
      "source": "/og/leaderboard/:name",
      "destination": "https://wezffxcyofkyhoowwjwi.supabase.co/functions/v1/lb-card?name=:name"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/leaderboard/:name",
      "destination": "/api/person?name=:name"
    },
    {
      "source": "/leaderboard/:name/",
      "destination": "/api/person?name=:name"
    }
  ],
  "redirects": [
    {
      "source": "/claudopus.mp4",
      "destination": "/tour.mp4",
      "permanent": false
    },
    {
      "source": "/tour",
      "destination": "/tour.html",
      "permanent": false
    }
  ],
  "functions": {
    "api/person.js": {
      "includeFiles": "leaderboard.html"
    }
  }
}
